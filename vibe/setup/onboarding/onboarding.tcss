$relay_green: #39FF88;
$relay_green_soft: #7CFF9B;
$relay_bg: #06110B;
$relay_cream: #F1E8C8;
$relay_amber: #FFB000;
$relay_blue: #2F5BEA;
$relay_red: #E53935;

/* =============================================================================
   Onboarding App Styles
   ============================================================================= */

Screen {
    align: center middle;
    background: $relay_bg;
}

OnboardingScreen {
    align: center middle;
}

/* =============================================================================
   Welcome Screen
   ============================================================================= */

#welcome-container {
    align: center middle;
}

#welcome-text {
    border: round $relay_green;
    padding: 1 3;
    margin-bottom: 2;
    text-align: center;
    width: auto;
}

#welcome-subtitle {
    color: $relay_cream;
    margin-bottom: 1;
    text-align: center;
}

WelcomeScreen #enter-hint {
    color: $relay_green_soft;
    min-width: 16;
    text-align: center;
}

WelcomeScreen #enter-hint.hidden {
    visibility: hidden;
}

/* =============================================================================
   API Key Screen
   ============================================================================= */

#api-key-outer {
    overflow-y: auto;
}

.spacer {
    height: 1fr;
}

#api-key-title {
    text-align: center;
    margin-bottom: 2;
    color: $relay_green;
}

#api-key-content {
    width: auto;
    height: auto;
}

#api-key-content Static {
    text-align: center;
}

.link-row {
    width: auto;
    height: auto;
    margin-top: 1;
}

.link-chevron {
    width: auto;
}

#input-box {
    border: round $relay_green;
    padding: 0 1;
    margin-top: 2;
    width: auto;
    height: 3;
}

#input-box.valid {
    border: round $relay_green;
}

#input-box.invalid {
    border: round $relay_red;
}

#key {
    border: none;
    width: 48;
    height: 1;
    padding: 0;
}

#paste-hint {
    margin-top: 3;
}

#feedback {
    text-align: center;
    height: 1;
    margin-top: 1;
}

#feedback.error {
    color: ansi_red;
}

#feedback.success {
    color: $relay_green_soft;
}

#config-docs-section {
    width: 100%;
    height: auto;
    align: center top;
    padding-bottom: 2;
}

#config-docs-group {
    width: auto;
    height: auto;
}

#config-docs-group Static {
    color: $relay_cream;
}

#config-docs-group .link-row {
    margin-top: 0;
}
