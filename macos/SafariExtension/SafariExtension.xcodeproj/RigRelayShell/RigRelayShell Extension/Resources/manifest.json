{
  "manifest_version": 3,
  "name": "Rig Relay Companion",
  "version": "0.1.0",
  "description": "Recognizes GitHub repository pages and provides a handoff from Safari to the Rig Relay native macOS application.",
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "16.0"
    }
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://github.com/*",
    "*://*.github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://github.com/*",
        "*://*.github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png"
    }
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png"
  },
  "default_locale": "en"
}
