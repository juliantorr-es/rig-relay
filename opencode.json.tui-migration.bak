{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "README.md", "pyproject.toml"],
  "permission": {
    "bash": "allow",
    "edit": "allow"
  },
  "lsp": true,
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "formatter": {
    "ruff": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "watcher": {
    "ignore": [".build/**", "dist/**", "sdist/**", ".venv/**", "node_modules/**", ".git/**"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
