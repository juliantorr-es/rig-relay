{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rig Relay Result v1",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "operation_id",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.result.v1"
    },
    "session_id": {
      "type": "string"
    },
    "operation_id": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "lane_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed", "cancelled"]
    },
    "events_jsonl": {
      "type": "string"
    },
    "observability_jsonl": {
      "type": "string"
    },
    "receipt_candidates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "files_touched": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
