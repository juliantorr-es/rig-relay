    "last_reviewed_at": "2026-05-18"
  },
  "intent_patterns": [
    "frontend breadcrumb",
    "browser-safe trace event",
    "trace endpoint",
    "token leakage",
    "frontend status rendered"
  ],
  "applies_when": {
    "symptoms": [
      "frontend events missing from trace store",
      "browser run shows disconnected without trace breadcrumbs"
    ],
    "traceback_patterns": [
      "frontend trace event ignored",
      "unsupported event type"
    ],
    "file_patterns": [
      "frontend/desktop/js/utils.js",
      "frontend/desktop/js/status.js",
      "rig_relay/desktop/bridge_server.py"
    ],
    "test_patterns": [
      "tests/frontend/test_frontend_trace_endpoint.py",
      "tests/desktop/test_golden_path.py"
    ],
    "user_prompt_patterns": [
      "frontend trace endpoint",
      "browser-safe breadcrumb",
      "trace events missing"
    ]
  },
  "required_invariants": [
    "Frontend trace events use field type, not event.",
    "Browser fallback sends only to /frontend-event.",
    "Trace endpoint never derives from ws_url or websocket_url.",
    "No POST /ws.",
    "No token values are emitted in URL, body, console, trace, or debug panel.",
    "WebSocket /ws remains WebSocket-only."
  ],
  "validation_commands": [
    "uv run pytest tests/frontend/test_frontend_trace_endpoint.py tests/desktop/test_websocket_correlation.py -q",
    "uv run pytest tests/desktop/test_golden_path_browser_integration.py -q"
  ],
  "forbidden_patterns": [
    "POST to /ws",
    "token in query string",
    "trace sink derived from websocket_url"
  ],
  "required_files": [
    "frontend/desktop/js/utils.js",
    "rig_relay/desktop/bridge_server.py",
    "tests/frontend/test_frontend_trace_endpoint.py"
