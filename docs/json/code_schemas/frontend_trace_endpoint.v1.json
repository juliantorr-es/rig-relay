  "required_tests": [
    "tests/frontend/test_frontend_trace_endpoint.py",
    "tests/desktop/test_golden_path.py"
  ],
  "required_trace_events": [
    "frontend_transport_state",
    "frontend_status_rendered",
    "frontend_auth_ok"
  ],
  "required_receipts": [
    "bridge_probe.json"
  ],
  "context_pack": {
    "include_files": [
      "frontend/desktop/js/utils.js",
      "frontend/desktop/js/status.js",
      "rig_relay/desktop/bridge_server.py"
    ],
    "include_docs": [
      "docs/json/governance/frontend-rendering-safety.v1.json",
