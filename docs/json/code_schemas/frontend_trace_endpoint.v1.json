      "docs/schemas/rig.documentation.page.v1.schema.json"
    ],
    "exclude_patterns": [
      "docs/pages/**",
      "**/*.html"
    ],
    "max_context_notes": 12
  },
  "model_facing_summary": "Use the browser-safe frontend trace sink. Emit breadcrumbs through /frontend-event with type and handshake_id. Never route frontend breadcrumbs to /ws or emit token values."
}
