{
  "schema_version": "rig.code_schema.v1",
  "document_id": "frontend-trace-endpoint",
  "schema_id": "frontend_trace_endpoint.v1",
  "title": "Frontend Trace Endpoint",
  "summary": "Browser-safe trace breadcrumbs for local desktop runs without sending frontend events to /ws.",
  "change_kind": "frontend_observability",
  "status": "active",
  "authority": {
    "authority_kind": "repo_governance",
    "trusted": true,
