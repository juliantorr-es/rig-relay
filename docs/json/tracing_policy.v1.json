  "policy": {
    "release_gate": "Every release-critical golden-path stage emits a correlated trace event carrying trace_id, span_id, and handshake_id. The app does not 'work' until the golden path can prove it worked from one correlated trace.",
    "trace_name": "desktop_launch_trace",
    "envelope_version": "rig.trace_event.v1",
    "content_rule": "Trace payloads are content-light. No token values, no full file contents, no prompt payloads, no model outputs.",
    "receipts_vs_traces": "Receipts are durable evidence with content hashes. Traces are causal navigation with correlation IDs. They are separate stores.",
    "redaction_rule": "token_value_included must always be false in emitted golden-path traces. token_present may be true as a boolean.",
    "handshake_rule": "Desktop/frontend/WebSocket events must carry handshake_id for cross-subsystem correlation.",
    "projection_rule": "Projection events must carry projection_id when available.",
    "status_contradiction_rule": "UI rendered state must be trace-comparable to canonical reducer state. Contradictions emit frontend.status_contradiction_detected.",
    "shutdown_rule": "Shutdown must write or print a trace summary.",
    "strict_mode_stages": [
      "bridge started",
      "server bound",
      "frontend booted",
      "runtime config loaded",
      "websocket connected",
      "auth ok",
      "projection sent",
      "projection received",
      "projection rendered",
      "status rendered",
      "ready reached",
      "shutdown observed"
    ],
    "failure_conditions": {
      "missing_trace_id": "Cannot correlate. Useless breadcrumb confetti.",
      "missing_handshake_id_on_desktop_frontend_websocket_events": "Cannot join frontend to bridge.",
      "token_value_appears_anywhere": "Security bug. Straight to airlock.",
      "frontend_auth_ok_without_desktop_websocket_auth_ok": "Split-brain auth trace.",
      "desktop_projection_sent_without_frontend_projection_received": "Transport/protocol seam broke.",
      "frontend_projection_received_without_frontend_projection_rendered": "Renderer seam broke.",
      "frontend_status_rendered_contradicts_reducer_state": "UI is lying."
    }
