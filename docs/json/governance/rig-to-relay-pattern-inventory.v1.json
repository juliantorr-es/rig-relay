      ],
      "rows": [
        [
          "ChatUI / Composer",
          "`src/rig/domain/projection_builder.py` (ChatProjection, ChatMessage)",
          "Rig Relay is a CLI harness, not a chat product"
        ],
        [
          "WorkspaceHeader / ProposalLifecycle",
          "`src/rig/domain/projections.py`",
          "Rig-specific product domain; Rig Relay has no workspace model"
        ],
        [
          "AuditTrail / IntegrityStatusCard",
          "`src/rig/domain/projection_builder.py`",
          "Rig-specific governance model; Rig Relay has its own guard/coordination/telemetry gates"
        ],
        [
          "Job store",
          "`src/rig/domain/` (various)",
          "Rig Relay uses CoordinationStore + coordination leases instead"
        ],
        [
          "Intake auth/onboarding",
          "`src/rig/domain/auth_models.py` (partial)",
          "Rig Relay has its own telemetry consent and update policy"
        ],
        [
          "UIServer",
          "`src/rig_tools/ui_server.py`",
          "Too tightly coupled to Rig's auth/receipt model. Will reimplement in WebSocket phase"
        ]
      ],
