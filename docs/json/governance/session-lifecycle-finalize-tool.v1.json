    {
      "block_id": "h2-22",
      "type": "heading",
      "level": 2,
      "content": "Protected Paths",
      "disclosure": {
        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "p-23",
      "type": "paragraph",
      "content": "The following file classes are never compacted or pruned:",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "p-24",
      "type": "paragraph",
      "content": "- Receipts (`receipt`, `receipts` in filename) - Consent (`consent` in filename) - Upload receipts (`upload` + `receipt`) - Signed envelopes (`signed`, `envelope` in filename) - Active session markers (`active` in path or filename) - Pinned session markers (`pinned` in path or filename)",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "h2-25",
      "type": "heading",
      "level": 2,
      "content": "Content-Light Guarantees",
      "disclosure": {
        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "p-26",
      "type": "paragraph",
      "content": "The result model contains:",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "p-27",
      "type": "paragraph",
      "content": "- **Allowed:** counts, paths, hashes (`line_sha256`), byte totals, statuses, retention decisions, schema versions - **Forbidden:** raw prompts, raw model outputs, stdout/stderr bodies, secrets, source diffs, file content",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "p-28",
      "type": "paragraph",
      "content": "Compact rollups use gzip with content-light line hashes (SHA256 of each line, no raw content).",
      "disclosure": {
        "level": "standard"
      }
    },
