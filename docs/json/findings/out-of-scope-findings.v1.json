        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "table-4",
      "type": "table",
      "columns": [
        "Kind",
        "Description"
      ],
      "rows": [
        [
          "`architecture_debt`",
          "Structural design debt that constrains future work"
        ],
        [
          "`lifecycle_semantics`",
          "Session/runtime lifecycle behavior that violates intended semantics"
        ],
        [
          "`telemetry_schema_gap`",
          "Missing or incomplete observability metadata"
        ],
        [
          "`lint_refactor`",
          "Recurring lint pressure indicating function-level design issues"
        ],
        [
          "`safety_guard_gap`",
          "Gaps in dirty-file, mutation, or safety guard coverage"
        ],
        [
          "`coordination_gap`",
          "Missing or incomplete cross-session coordination primitives"
        ],
        [
          "`documentation_gap`",
          "Missing or outdated documentation"
        ],
        [
          "`provider_boundary_gap`",
          "Provider/model boundary leakage or missing abstraction"
        ],
        [
          "`testing_gap`",
          "Missing test coverage or test infrastructure"
        ]
