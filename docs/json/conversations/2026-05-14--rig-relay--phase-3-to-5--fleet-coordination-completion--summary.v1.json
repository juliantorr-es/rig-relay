    {
      "block_id": "p-43",
      "type": "paragraph",
      "content": "- validate → `execute_validate()` - runtime_exec → `execute_runtime_exec()` (governed path) - message/handoff_note → immediate completion - pause/resume → no-op (completes) - unsupported → blocked",
      "disclosure": {
        "level": "standard"
      }
