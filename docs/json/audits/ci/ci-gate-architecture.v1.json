          "`uv run rig-relay --help && uv run rig-relay-acp --help`",
          "Fast",
          "✅ (ci.yml)"
        ],
        [
          "Typos check",
          "via pre-commit hook",
          "Fast",
          "✅ (ci.yml pre-commit job)"
        ]
      ],
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "p-14",
      "type": "paragraph",
      "content": "**Not in Tier 1:** Full pytest suite, snapshot tests, build checks — too slow or environment-sensitive.",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "h3-15",
      "type": "heading",
      "level": 3,
      "content": "Tier 2 — Domain-Specific Required Gates",
      "disclosure": {
        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "p-16",
      "type": "paragraph",
      "content": "- Run **only when relevant paths change** (see `ci-path-trigger-map.md`) - Required for PR merge when triggered - Moderate cost (5–30 seconds)",
      "disclosure": {
        "level": "standard"
      }
    },
    {
