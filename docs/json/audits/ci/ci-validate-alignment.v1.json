          "`validate schemas`"
        ],
        [
          "`scripts/rig_relay_validate_tool_receipts.py`",
          "`tests/evidence/test_tool_receipt_policy.py`",
          "`validate receipt-policy`"
        ],
        [
          "`scripts/rig_relay_validate_telemetry_bundle.py`",
          "Manual testing only",
          "`validate schemas` or `validate governance`"
        ],
        [
          "`pylint.yml` (stale)",
          "`ruff` via pre-commit",
          "Remove, no consolidation needed"
        ],
