        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "table-8",
      "type": "table",
      "columns": [
        "API Area",
        "Purpose",
        "Rig Use Case",
        "Rationale for Deferral"
      ],
      "rows": [
        [
          "**Task API**",
          "Running build/test tasks.",
          "Executing validations.",
          "Defer to daemon tools for governance."
        ],
        [
          "**Authentication API**",
          "Third-party auth.",
          "GitHub/Mistral login.",
          "Keep in daemon for token isolation."
        ],
        [
          "**Integrated Terminal Write**",
          "Injecting text into shell.",
          "Auto-running commands.",
          "Too risky; bypasses tool permissions."
        ]
      ],
      "disclosure": {
        "level": "standard"
      }
