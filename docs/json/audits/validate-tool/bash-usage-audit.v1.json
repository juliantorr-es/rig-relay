  "title": "Bash Usage Audit for Validate Design",
  "summary": "This audit synthesizes existing bash hardening evidence, tool-usage aggregates, validator scripts, and test surfaces to design a deterministic `validate` tool. It does not implement `validate`.",
  "status": "active",
  "created_at": "2026-05-16",
