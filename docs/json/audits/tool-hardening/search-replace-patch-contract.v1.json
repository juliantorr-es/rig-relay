      "content": "- `docs/schemas/rig.relay.search_replace_invocation.v1.schema.json` - `docs/schemas/rig.relay.search_replace_result.v1.schema.json` - `docs/schemas/rig.relay.search_replace_receipt.v1.schema.json`",
