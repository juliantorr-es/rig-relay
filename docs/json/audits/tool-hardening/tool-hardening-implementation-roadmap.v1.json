      "type": "paragraph",
      "content": "Files likely affected:",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "p-9",
      "type": "paragraph",
      "content": "- `vibe/core/tools/builtins/search_replace.py` - `tests/tools/test_tool_receipt_emission.py` - `tests/evidence/test_tool_receipt_policy.py` - `tests/evidence/test_receipt_index.py`",
