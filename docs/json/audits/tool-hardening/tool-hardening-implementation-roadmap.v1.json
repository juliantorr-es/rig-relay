    },
    {
      "block_id": "p-6",
      "type": "paragraph",
      "content": "Goal:",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "p-7",
      "type": "paragraph",
      "content": "- remove the last avoidable SearchReplace evidence gaps.",
      "disclosure": {
        "level": "standard"
