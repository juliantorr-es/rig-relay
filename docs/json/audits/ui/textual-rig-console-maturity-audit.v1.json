        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "p-11",
      "type": "paragraph",
      "content": "- Mutation tools - Raw command router - Runtime supervisor - Coordination repair - Audit persistence - Receipt generation",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "h2-12",
      "type": "heading",
      "level": 2,
      "content": "4. Gap Inventory & Risks",
      "disclosure": {
        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "table-13",
      "type": "table",
