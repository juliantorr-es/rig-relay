    {
      "block_id": "p-12",
      "type": "paragraph",
      "content": "**Fix**: Added `_finalize_span()` helper (lazy evaluating, handles None trace_status cleanly). All 7 terminal return paths now call it.",
      "disclosure": {
        "level": "standard"
      }
    },
