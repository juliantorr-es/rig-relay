      "level": 2,
      "content": "Privacy Model",
      "disclosure": {
        "level": "standard",
        "initially_visible": true
      }
    },
    {
      "block_id": "p-17",
      "type": "paragraph",
      "content": "The following fields are **never** emitted into ToolRuntime trace spans, result dicts, or receipt envelope: - Raw stdout, stderr, argv, cwd, env, shell command - Frontend paths, URLs - Auth tokens, API keys - Raw exception repr strings (truncated to 500 chars for error_message)",
      "disclosure": {
        "level": "standard"
      }
    },
    {
      "block_id": "p-18",
      "type": "paragraph",
      "content": "Allowed in trace/receipt: envelope id, envelope sha, classification, byte counts, hashes, safe refusal/error kind, duration, tool name, tool call id.",
      "disclosure": {
        "level": "standard"
      }
    },
