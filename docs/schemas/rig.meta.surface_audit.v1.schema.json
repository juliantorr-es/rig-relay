{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.meta.surface_audit.v1.schema.json",
  "title": "Meta Surface Audit v1",
  "description": "Proposal packets for future Meta features without live API calls. Refuses publishing, messaging, webhooks in v1.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "content_light",
    "remote_mutation",
    "live_network",
    "packets",
    "packet_count",
    "refused_packet_count",
    "evidence_paths",
    "remaining_seams",
    "redaction_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.meta.surface_audit.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "branch": {
      "type": ["string", "null"]
    },
    "head": {
      "type": ["string", "null"]
    },
    "content_light": {
      "type": "boolean",
      "const": true
    },
    "remote_mutation": {
      "type": "boolean",
      "const": false
    },
    "live_network": {
      "type": "boolean",
      "const": false
    },
    "packets": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/audit_packet"
      }
    },
    "packet_count": {
      "type": "integer",
      "minimum": 0
    },
    "refused_packet_count": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_paths": {
      "type": "array",
      "items": {"type": "string"}
    },
    "remaining_seams": {
      "type": "array",
      "items": {"type": "string"}
    },
    "redaction_status": {
      "$ref": "#/definitions/redaction_status"
    },
    "summary": {
      "$ref": "#/definitions/summary"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "audit_packet": {
      "type": "object",
      "required": [
        "packet_id",
        "surface",
        "proposed_future_action",
        "current_status",
        "required_config_refs",
        "required_permission_refs",
        "blocked_by",
        "user_data_risk",
        "remote_mutation",
        "content_light",
        "public_release_relevance",
        "safety_notes"
      ],
      "properties": {
        "packet_id": {"type": "string"},
        "surface": {
          "type": "string",
          "enum": [
            "facebook_pages",
            "instagram_graph",
            "whatsapp_business_cloud",
            "webhooks",
            "publishing_surfaces",
            "messaging_surfaces",
            "app_review",
            "business_verification"
          ]
        },
        "proposed_future_action": {"type": "string"},
        "current_status": {
          "type": "string",
          "enum": [
            "refused",
            "deferred",
            "blocked_by_app_review",
            "blocked_by_business_verification",
            "not_implemented"
          ]
        },
        "required_config_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "required_permission_refs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "blocked_by": {
          "type": "array",
          "items": {"type": "string"}
        },
        "user_data_risk": {
          "type": "string",
          "enum": ["low", "medium", "high", "restricted"]
        },
        "remote_mutation": {"type": "boolean"},
        "content_light": {"type": "boolean"},
        "public_release_relevance": {"type": "string"},
        "safety_notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "redaction_status": {
      "type": "object",
      "required": [
        "content_light",
        "forbidden_strings_present",
        "redaction_rule_count"
      ],
      "properties": {
        "content_light": {"type": "boolean", "const": true},
        "forbidden_strings_present": {"type": "boolean", "const": false},
        "redaction_rule_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "total_packets",
        "refused_packets",
        "deferred_packets",
        "blocked_packets"
      ],
      "properties": {
        "total_packets": {"type": "integer", "minimum": 0},
        "refused_packets": {"type": "integer", "minimum": 0},
        "deferred_packets": {"type": "integer", "minimum": 0},
        "blocked_packets": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
