{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.runtime_cache_event.v1.schema.json",
  "title": "Runtime Cache Event",
  "description": "Canonical evidence for cache authority operations.",
  "type": "object",
  "required": [
    "schema_version",
    "content_light",
    "evidence_id",
    "runtime_kind",
    "captured_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version identifier for this payload shape."
    },
    "content_light": {
      "const": true,
      "description": "Content-light guarantee: no raw cache contents or secrets."
    },
    "evidence_id": {
      "type": "string",
      "description": "Unique identifier for this cache evidence record."
    },
    "runtime_kind": {
      "type": "string",
      "description": "Runtime kind identifier (e.g., rigged_mlx_internal)."
    },
    "captured_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of capture."
    },
    "kv_cache_enabled": {
      "type": "boolean",
      "description": "Whether KV-cache reuse is enabled."
    },
    "cache_size_estimate_mb": {
      "type": "number",
      "description": "Estimated cache size in megabytes."
    },
    "clear_count": {
      "type": "integer",
      "description": "Number of explicit cache clear operations."
    },
    "cache_hit_ratio": {
      "type": "number",
      "description": "Estimated cache hit ratio."
    },
    "cache_projection_hash": {
      "type": "string",
      "description": "SHA256 hash of the cache projection state."
    }
  },
  "additionalProperties": false
}
