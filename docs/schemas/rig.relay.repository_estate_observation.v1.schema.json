{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "rig.relay.repository_estate_observation.v1",
  "title": "Repository Estate Observation",
  "description": "Schema for a single repository observation event in the Repository Estate evidence domain. Chainable via previous_observation_digest. Content-light: digests, counts, labels — never raw file contents, raw paths, or secrets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "repository_hash",
    "observed_at",
    "status",
    "root_path_digest",
    "git_facts",
    "observation_digest",
    "content_light_guarantee"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.repository_estate_observation.v1"
    },
    "observation_id": {
      "type": "string",
      "description": "Unique observation event identifier (UUID4)."
    },
    "repository_hash": {
      "type": "string",
      "description": "The registered repository this observation belongs to."
    },
    "observed_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of observation."
    },
    "status": {
      "type": "string",
      "enum": [
        "registered",
        "observed",
        "unchanged",
        "changed",
        "inaccessible",
        "not_a_repository",
        "disappeared"
      ],
      "description": "Observation outcome."
    },
    "root_path_digest": {
      "type": "string",
      "description": "SHA256 hex digest of the resolved repository root path at observation time."
    },
    "git_facts": {
      "type": "object",
      "description": "Content-light git operational facts.",
      "additionalProperties": false,
      "required": [
        "head_sha",
        "branch",
        "is_detached",
        "dirty_counts",
        "tracked_file_count",
        "is_github_backed",
        "is_local_only",
        "remotes",
        "git_common_dir_digest",
        "instruction_files"
      ],
      "properties": {
        "head_sha": {
          "type": ["string", "null"],
          "description": "Full SHA of HEAD commit."
        },
        "branch": {
          "type": ["string", "null"],
          "description": "Branch name, null if detached."
        },
        "is_detached": {
          "type": "boolean",
          "description": "Whether HEAD is detached."
        },
        "dirty_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["modified", "staged", "untracked", "deleted", "conflicted"],
          "properties": {
            "modified": { "type": "integer" },
            "staged": { "type": "integer" },
            "untracked": { "type": "integer" },
            "deleted": { "type": "integer" },
            "conflicted": { "type": "integer" }
          }
        },
        "tracked_file_count": {
          "type": "integer",
          "description": "Count of tracked files (git ls-files)."
        },
        "is_github_backed": {
          "type": "boolean",
          "description": "Whether at least one remote is github.com."
        },
        "is_local_only": {
          "type": "boolean",
          "description": "Whether no remotes are configured."
        },
        "remotes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "url_digest", "host"],
            "properties": {
              "name": { "type": "string" },
              "url_digest": { "type": "string" },
              "host": { "type": "string" }
            }
          },
          "description": "Git remote records (url_digest only)."
        },
        "git_common_dir_digest": {
          "type": ["string", "null"],
          "description": "Content-based digest of .git/common directory."
        },
        "instruction_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "path_digest", "content_sha256"],
            "properties": {
              "kind": { "type": "string" },
              "path_digest": { "type": "string" },
              "content_sha256": { "type": "string" }
            }
          },
          "description": "Instruction file presence records (digests only)."
        }
      }
    },
    "previous_observation_digest": {
      "type": ["string", "null"],
      "description": "SHA256 hex digest of the previous observation for this repository."
    },
    "observation_digest": {
      "type": "string",
      "description": "SHA256 hex digest of this observation (canonical JSON hash excluding this field)."
    },
    "content_light_guarantee": {
      "type": "boolean",
      "description": "This observation contains only content-light data."
    }
  }
}
