{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.github.carte_blanche_endpoint_matrix.v1.schema.json",
  "title": "GitHub Carte Blanche Endpoint Matrix v1",
  "description": "Maps key GitHub REST/GraphQL endpoints to Relay capabilities under full trust.",
  "type": "object",
  "required": ["schema_version", "generated_at", "content_light", "remote_mutation", "total_endpoints", "endpoints", "summary"],
  "properties": {
    "schema_version": {"type": "string", "const": "rig.github.carte_blanche_endpoint_matrix.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "content_light": {"type": "boolean", "const": true},
    "remote_mutation": {"type": "boolean", "const": false},
    "total_endpoints": {"type": "integer", "minimum": 0},
    "endpoints": {"type": "array", "items": {"$ref": "#/definitions/endpoint_entry"}},
    "summary": {"type": "object", "required": ["read_endpoints", "write_endpoints", "mutation_endpoints", "webhook_endpoints"], "properties": {
      "read_endpoints": {"type": "integer"}, "write_endpoints": {"type": "integer"},
      "mutation_endpoints": {"type": "integer"}, "webhook_endpoints": {"type": "integer"}
    }, "additionalProperties": false}
  },
  "additionalProperties": true,
  "definitions": {
    "endpoint_entry": {
      "type": "object",
      "required": ["endpoint_id", "method", "path_template", "required_permission", "operation_class"],
      "properties": {
        "endpoint_id": {"type": "string"}, "method": {"type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD"]},
        "path_template": {"type": "string"}, "required_permission": {"type": "string"},
        "operation_class": {"type": "string", "enum": ["read_only", "remote_read", "remote_mutation", "credentialed_remote_mutation", "destructive"]},
        "works_with_github_app": {"type": "boolean"}, "works_with_installation_token": {"type": "boolean"},
        "requires_user_oauth": {"type": "boolean"}, "plan_limited": {"type": "boolean"},
        "relay_lane": {"type": "string"}, "official_docs_ref": {"type": "string"},
        "rate_limit_category": {"type": "string"}, "risk_level": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
