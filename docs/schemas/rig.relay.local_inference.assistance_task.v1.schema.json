{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.local_inference.assistance_task.v1.schema.json",
  "title": "Local Inference Assistance Task v1",
  "description": "Typed local-model assistance task definition. Each task states its required enforcement class from Lane D's EnforcementClass. A task requiring structured output must refuse if the local runtime lacks sufficient evidence-backed admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "task_kind",
    "created_at",
    "required_enforcement_class",
    "target_publication_applicability"
  ],
  "properties": {
    "schema_version": { "const": "rig.relay.local_inference.assistance_task.v1" },
    "task_id": { "type": "string" },
    "task_kind": {
      "type": "string",
      "enum": [
        "project_summary",
        "page_section_ordering",
        "capability_classification",
        "missing_material_checklist"
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "required_enforcement_class": {
      "type": "string",
      "enum": [
        "unsupported",
        "json_object_formatting_only",
        "native_json_schema",
        "native_grammar_gbnf"
      ]
    },
    "context_packet_digest": { "type": "string" },
    "parameters": { "type": "object" },
    "target_publication_applicability": {
      "type": "string",
      "enum": ["project_page", "portfolio", "internal_only", "none"]
    }
  }
}
