{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.tool_constraint_compilation_receipt.v1.schema.json",
  "title": "Tool Constraint Compilation Receipt v1",
  "description": "Receipt for safe-subset constraint compilation from canonical tool manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "compilation_id", "created_at", "manifest_digest",
    "target_profile", "tools_total", "tools_fully_representable",
    "tools_proposal_only", "constraint_artifact_digest", "receipt_digest"
  ],
  "properties": {
    "schema_version": { "const": "rig.relay.tool_constraint_compilation_receipt.v1" },
    "compilation_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "target_profile": { "type": "string" },
    "tools_total": { "type": "integer", "minimum": 0 },
    "tools_fully_representable": { "type": "integer", "minimum": 0 },
    "tools_refused_unsupported_features": { "type": "integer", "minimum": 0 },
    "tools_proposal_only": { "type": "integer", "minimum": 0 },
    "feature_statuses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature", "status"],
        "properties": {
          "feature": { "type": "string" },
          "status": { "enum": ["preserved", "omitted_with_refusal", "unsupported_for_runtime", "compilation_refused"] },
          "reason": { "type": "string" }
        }
      }
    },
    "tool_schema_digests": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
    },
    "constraint_artifact_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "receipt_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
