{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://rig-relay.local/schemas/rig.relay.provider_onboarding_result.v1.schema.json",
    "title": "Provider Onboarding Result",
    "description": "Content-light result of a provider onboarding operation. Never contains raw API keys.",
    "type": "object",
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "rig.relay.provider_onboarding_result.v1"
        },
        "provider": {
            "type": "string",
            "enum": ["openai", "anthropic", "google", "openrouter", "deepseek"]
        },
        "status": {
            "type": "string",
            "enum": ["completed", "failed"]
        },
        "key_source": {
            "type": "string",
            "enum": ["env", "keychain", "dev_file", "missing"]
        },
        "key_fingerprint": {
            "type": "string",
            "description": "SHA256 prefix hash of the API key. Not the key itself."
        },
        "summary": {
            "type": "string"
        },
        "warnings": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": ["schema_version", "provider", "status", "key_source"],
    "additionalProperties": false
}
