{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.github.code_scanning_patch_proposal.v1.schema.json",
  "title": "GitHub Code Scanning Fix Patch Proposal v1",
  "description": "Governed, content-light, proposal-only patch strategy for top-ranked code scanning alert.",
  "type": "object",
  "required": ["schema_version", "generated_at", "content_light", "source_surface", "remote_mutation_status", "local_mutation_status", "pr_creation_status", "alert_update_status", "human_review_required"],
  "properties": {
    "schema_version": {"type": "string", "const": "rig.github.code_scanning_patch_proposal.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "content_light": {"type": "boolean", "const": true},
    "source_queue_artifact": {"type": "string"},
    "source_remediation_plan_artifact": {"type": "string"},
    "selected_plan_id": {"type": ["string", "null"]},
    "selected_queue_item_id": {"type": ["string", "null"]},
    "source_surface": {"type": "string", "const": "code_scanning"},
    "alert_identifier_hash": {"type": ["string", "null"]},
    "alert_number": {"type": ["integer", "null"]},
    "severity": {"type": "string"},
    "rule_id_hash": {"type": ["string", "null"]},
    "rule_category": {"type": "string"},
    "location_summary_safe": {"type": "string"},
    "affected_path_hashes": {"type": "array", "items": {"type": "string"}},
    "evidence_available": {"type": "boolean"},
    "evidence_missing": {"type": "array", "items": {"type": "string"}},
    "patch_strategy": {"type": "string"},
    "patch_summary_safe": {"type": "string"},
    "proposed_file_operations": {"type": "array", "items": {"type": "string"}},
    "proposed_diff_summary": {"type": "string"},
    "proposed_test_strategy": {"type": "array", "items": {"type": "string"}},
    "required_read_permissions": {"type": "array", "items": {"type": "string"}},
    "required_mutation_permissions_later": {"type": "array", "items": {"type": "string"}},
    "remote_mutation_status": {"type": "string", "const": "disabled"},
    "local_mutation_status": {"type": "string", "const": "disabled"},
    "pr_creation_status": {"type": "string", "const": "disabled"},
    "alert_update_status": {"type": "string", "const": "disabled"},
    "confidence": {"type": "string"},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "human_review_required": {"type": "boolean", "const": true},
    "redaction_status": {"type": "object"},
    "content_light_status": {"type": "string"},
    "recommended_next_slice": {"type": "string"}
  },
  "additionalProperties": true
}
