{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.copilot_ci_pr_review.v1.schema.json",
  "title": "Copilot CI/CD PR Review v1",
  "description": "Structured review of a Copilot-generated CI/CD PR against Rig Relay's CI safety doctrine.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "reviewed_pr_number",
    "reviewed_pr_branch",
    "base_branch",
    "base_head_sha",
    "pr_head_sha",
    "dirty_state_before",
    "dirty_state_after",
    "files_changed_by_pr",
    "workflows_changed",
    "required_lanes_found",
    "advisory_lanes_found",
    "permissions_review",
    "cache_review",
    "live_auth_policy_review",
    "artifact_upload_review",
    "job_summary_review",
    "local_reproduction_commands",
    "tests_run",
    "tests_skipped",
    "violations",
    "warnings",
    "recommendation"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.copilot_ci_pr_review.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "reviewed_pr_number": { "type": ["integer", "null"] },
    "reviewed_pr_branch": { "type": "string" },
    "base_branch": { "type": "string" },
    "base_head_sha": { "type": "string" },
    "pr_head_sha": { "type": "string" },
    "dirty_state_before": { "type": "boolean" },
    "dirty_state_after": { "type": "boolean" },
    "files_changed_by_pr": { "type": "array", "items": { "type": "string" } },
    "workflows_changed": { "type": "array", "items": { "type": "string" } },
    "required_lanes_found": { "type": "array", "items": { "type": "string" } },
    "advisory_lanes_found": { "type": "array", "items": { "type": "string" } },
    "permissions_review": { "type": "string" },
    "cache_review": { "type": "string" },
    "live_auth_policy_review": { "type": "string" },
    "artifact_upload_review": { "type": "string" },
    "job_summary_review": { "type": "string" },
    "local_reproduction_commands": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "tests_skipped": { "type": "array", "items": { "type": "string" } },
    "violations": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "recommendation": { "type": "string", "enum": ["approve", "request_changes", "needs_manual_review"] }
  }
}
