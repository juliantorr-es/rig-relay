{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/juliantorr-es/rig-relay/blob/main/docs/schemas/rig.site_renderer.input_manifest.v1.schema.json",
  "title": "Rig Site Renderer Input Manifest v1",
  "description": "Schema for the input manifest that catalogues renderable artifacts for the Rig Relay static site renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "head_sha",
    "branch",
    "inputs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema identifier for this manifest."
    },
    "schema_version": {
      "type": "string",
      "const": "rig.site_renderer.input_manifest.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of manifest generation."
    },
    "head_sha": {
      "type": "string",
      "description": "Git HEAD SHA at generation time (may be 'unknown' when the renderer has not resolved it)."
    },
    "branch": {
      "type": "string",
      "description": "Git branch at generation time."
    },
    "inputs": {
      "type": "array",
      "description": "Ordered list of renderable input artifacts.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_path",
          "source_type",
          "page_target",
          "freshness_policy",
          "safety_class",
          "public_safe",
          "redaction_required"
        ],
        "properties": {
          "source_path": {
            "type": "string",
            "description": "Path to the source artifact, relative to the repository root."
          },
          "source_type": {
            "type": "string",
            "enum": [
              "json",
              "jsonl",
              "csv",
              "schema",
              "mermaid",
              "static_asset"
            ],
            "description": "The kind of source artifact."
          },
          "page_target": {
            "type": "string",
            "enum": [
              "release-candidate",
              "testing",
              "integrations",
              "telemetry",
              "frontend",
              "security",
              "schemas",
              "home"
            ],
            "description": "Which rendered page this artifact belongs to."
          },
          "freshness_policy": {
            "type": "string",
            "enum": [
              "always",
              "if_schema_valid",
              "optional"
            ],
            "description": "When to re-render this artifact."
          },
          "safety_class": {
            "type": "string",
            "enum": [
              "public_safe",
              "content_light",
              "redacted_required",
              "internal_only"
            ],
            "description": "Safety classification for publication."
          },
          "public_safe": {
            "type": "boolean",
            "description": "Whether the artifact is safe for public rendering."
          },
          "redaction_required": {
            "type": "boolean",
            "description": "Whether the artifact requires redaction before public rendering."
          },
          "schema_path": {
            "type": "string",
            "description": "Path to the JSON Schema that validates this artifact, relative to the repository root."
          },
          "title": {
            "type": "string",
            "description": "Human-readable title for the rendered page section."
          },
          "description": {
            "type": "string",
            "description": "Human-readable description for the rendered page section."
          },
          "renderer_kind": {
            "type": "string",
            "enum": [
              "release_gate",
              "rc_verdict",
              "golden_path",
              "test_inventory",
              "integration_manifest",
              "telemetry_policy",
              "bridge_lifecycle",
              "frontend_maturity",
              "security_hygiene",
              "generic_page",
              "code_schema",
              "threat_model",
              "homepage"
            ],
            "description": "The renderer component to use for this artifact."
          }
        }
      }
    }
  }
}
