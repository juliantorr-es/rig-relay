{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig.relay/schemas/runtime_tool_invocation_receipt.v1.json",
  "title": "Runtime Tool Invocation Receipt",
  "description": "Content-light adapter-level receipt for a tool invocation. Bridges RuntimeToolExecutionResult to the tool receipt, ReceiptEnvelope, and AuditEvent. Contains no raw file contents, stdout, stderr, diffs, snippets, or secrets.",
  "type": "object",
  "required": [
    "schema_version",
    "invocation_id",
    "intent_id",
    "tool_name",
    "adapter_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["rig.relay.runtime_tool_invocation_receipt.v1"],
      "description": "Schema version identifier"
    },
    "invocation_id": {
      "type": "string",
      "description": "Invocation ID from the adapter envelope"
    },
    "intent_id": {
      "type": "string",
      "description": "Intent ID from the original RuntimeToolIntent"
    },
    "tool_name": {
      "type": "string",
      "description": "Name of the tool that was executed"
    },
    "adapter_status": {
      "type": "string",
      "description": "Adapter-level execution status (completed, blocked, refused, failed)"
    },
    "tool_status": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Status returned by the tool"
    },
    "tool_error_kind": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Structured error kind from tool or adapter"
    },
    "supervisor_result_envelope_id": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Canonical RuntimeSupervisor result envelope ID"
    },
    "supervisor_result_envelope_sha256": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "SHA-256 of the canonical RuntimeSupervisor result envelope"
    },
    "supervisor_result_classification": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Normalized RuntimeSupervisor terminal classification"
    },
    "tool_receipt_kind": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Kind of tool receipt (e.g. validate, search_replace)"
    },
    "tool_receipt_schema_version": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Schema version of the tool receipt (e.g. rig.relay.validate_receipt.v1)"
    },
    "receipt_sha256": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "SHA-256 hash of the tool receipt canonical JSON"
    },
    "suggested_next_action": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "Operator-facing next step for recovering from a refusal or failure"
    },
    "retryable": {
      "oneOf": [
        { "type": "boolean" },
        { "type": "null" }
      ],
      "description": "Whether the refusal can usually be retried after following the advice"
    },
    "envelope_id": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "ReceiptEnvelope ID when one is built"
    },
    "audit_event_id": {
      "oneOf": [
        { "type": "string" },
        { "type": "null" }
      ],
      "description": "AuditEvent ID when one is created"
    },
    "changed_paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Files affected by mutation tools"
    },
    "duration_ms": {
      "oneOf": [
        { "type": "number" },
        { "type": "null" }
      ],
      "description": "Adapter-level wall clock duration in milliseconds"
    },
    "created_at": {
      "type": "string",
      "description": "ISO 8601 timestamp when the receipt was created"
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-fatal warnings from the execution"
    },
    "git_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/git_summary"
        },
        {
          "type": "null"
        }
      ],
      "description": "Schema-governed Git metadata projection for git/checkpoint tools"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "git_summary": {
      "type": "object",
      "properties": {
        "branch": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "head": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "dirty_files_count": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "changed_files_count": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "changed_paths": {
          "type": "array",
          "items": { "type": "string" }
        },
        "truncation_triggered": {
          "type": "boolean"
        },
        "redaction_triggered": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "base_identity": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "head_identity": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "commit_identity": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "checkpoint_receipt_sha256": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "bounded_stdout": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
