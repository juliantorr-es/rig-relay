{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mission Batch v1",
  "description": "Input bundle of mission texts to be routed.",
  "type": "object",
  "required": [
    "schema_version",
    "batch_id",
    "created_at",
    "user_request_summary",
    "mission_texts",
    "requested_by"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.fleet.mission_batch.v1"
    },
    "batch_id": {
      "type": "string",
      "description": "Unique identifier for the batch."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of creation."
    },
    "user_request_summary": {
      "type": "string",
      "description": "Short summary of the user's intent for the batch."
    },
    "mission_texts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of raw mission prompts/texts."
    },
    "requested_by": {
      "type": "string",
      "description": "Identifier of the user or agent requesting the batch."
    },
    "default_policy": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional default policies for the batch."
    },
    "mission_id": {
      "type": ["string", "null"]
    },
    "sprint_id": {
      "type": ["string", "null"]
    },
    "adr_id": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
