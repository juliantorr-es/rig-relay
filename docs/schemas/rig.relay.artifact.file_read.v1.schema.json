{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.artifact.file_read.v1.schema.json",
  "title": "File Read Artifact",
  "type": "object",
  "required": [
    "relative_path",
    "file_sha256",
    "size_bytes"
  ],
  "properties": {
    "relative_path": { "type": "string" },
    "file_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "size_bytes": { "type": "integer" },
    "excerpt_range": { "type": "string" },
    "excerpt_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifacted": { "type": "boolean" }
  },
  "additionalProperties": false
}
