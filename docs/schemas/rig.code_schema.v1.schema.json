{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.code_schema.v1.schema.json",
  "title": "Rig Code Schema",
  "description": "Governed implementation contract for recurring code-change patterns, invariants, tests, traces, and file boundaries.",
  "type": "object",
  "required": [
    "schema_version",
    "schema_id",
    "title",
    "change_kind",
    "status",
    "authority",
    "model_facing_summary",
    "context_pack"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.code_schema.v1"
    },
    "schema_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "change_kind": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "archived"]
    },
    "authority": {
      "type": "object",
      "required": [
        "authority_kind",
        "trusted",
        "source_path",
        "source_hash",
        "review_status",
        "last_reviewed_at"
      ],
      "properties": {
        "authority_kind": {"type": "string"},
        "trusted": {"type": "boolean"},
        "source_path": {"type": "string"},
        "source_hash": {"type": "string"},
        "review_status": {"type": "string"},
        "last_reviewed_at": {"type": "string"}
      },
      "additionalProperties": false
    },
    "intent_patterns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "applies_when": {
      "type": "object",
      "properties": {
        "symptoms": {
          "type": "array",
          "items": {"type": "string"}
        },
        "traceback_patterns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "file_patterns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "test_patterns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "user_prompt_patterns": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "required_invariants": {
      "type": "array",
      "items": {"type": "string"}
    },
    "forbidden_patterns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "optional_files": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_tests": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_trace_events": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_receipts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "context_pack": {
      "type": "object",
      "required": [
        "include_files",
        "include_docs",
        "include_schemas",
        "exclude_patterns",
        "max_context_notes"
      ],
      "properties": {
        "include_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "include_docs": {
          "type": "array",
          "items": {"type": "string"}
        },
        "include_schemas": {
          "type": "array",
          "items": {"type": "string"}
        },
        "exclude_patterns": {
          "type": "array",
          "items": {"type": "string"}
        },
        "max_context_notes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "model_facing_summary": {
      "type": "string"
    },
    "validation_commands": {
      "type": "array",
      "items": {"type": "string"}
    },
    "related_schemas": {
      "type": "array",
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
