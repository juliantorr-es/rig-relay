{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.github_provider.status_snapshot.v1.schema.json",
  "title": "GitHub Provider Status Snapshot v1",
  "description": "Local status snapshot of GitHub provider configuration, grants, and capability availability. Content-light: all content-derived values are hashed. Never calls the live GitHub API.",
  "type": "object",
  "required": [
    "schema_version",
    "provider_id",
    "generated_at",
    "auth_state_hash",
    "capability_manifest_hash",
    "configured_auth_modes",
    "available_capabilities",
    "refused_capabilities",
    "grant_count",
    "expired_grant_count",
    "revoked_grant_count",
    "repository_count",
    "rate_limit_status",
    "live_network_enabled",
    "content_light"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.github_provider.status_snapshot.v1"
    },
    "provider_id": {
      "type": "string",
      "const": "github"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "auth_state_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "SHA-256 hash of the auth state used to produce this snapshot."
    },
    "capability_manifest_hash": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "description": "SHA-256 hash of the capability manifest used."
    },
    "configured_auth_modes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "available_capabilities": {
      "type": "array",
      "items": {"type": "string"}
    },
    "refused_capabilities": {
      "type": "array",
      "items": {"type": "string"}
    },
    "grant_count": {
      "type": "integer",
      "minimum": 0
    },
    "expired_grant_count": {
      "type": "integer",
      "minimum": 0
    },
    "revoked_grant_count": {
      "type": "integer",
      "minimum": 0
    },
    "repository_count": {
      "type": "integer",
      "minimum": 0
    },
    "rate_limit_status": {
      "type": "string",
      "enum": ["unknown", "fixture", "unavailable"]
    },
    "live_network_enabled": {
      "type": "boolean",
      "const": false
    },
    "content_light": {
      "type": "boolean",
      "const": true
    }
  },
  "additionalProperties": false
}
