{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.artifact.search_query.v1.schema.json",
  "title": "Search Query Artifact",
  "type": "object",
  "required": [
    "query_text",
    "query_kind",
    "normalized_query_sha256"
  ],
  "properties": {
    "query_text": { "type": "string" },
    "query_kind": { "enum": ["literal", "regex", "fuzzy", "symbol", "semantic"] },
    "root_scope": { "type": "string" },
    "include_globs": { "type": "array", "items": { "type": "string" } },
    "exclude_globs": { "type": "array", "items": { "type": "string" } },
    "case_mode": { "enum": ["sensitive", "insensitive", "smart"] },
    "ignore_mode": { "type": "boolean" },
    "max_results": { "type": "integer" },
    "ranking_strategy": { "type": "string" },
    "ranking_version": { "type": "string" },
    "normalized_query_sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
