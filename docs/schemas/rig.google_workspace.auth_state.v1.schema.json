{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.google_workspace.auth_state.v1.schema.json",
  "title": "Google Workspace Auth State v1",
  "description": "Canonical Google Workspace authentication state. Records token metadata, scope grants, and subject/customer boundaries. Never stores raw tokens, private keys, client secrets, OAuth codes, JWT assertions, or raw email/domain identifiers.",
  "type": "object",
  "required": ["schema_version", "provider_id", "auth_mode", "auth_status", "account_hash", "scope_grants", "generated_at", "redaction_status"],
  "properties": {
    "schema_version": {"type": "string", "const": "rig.google_workspace.auth_state.v1"},
    "provider_id": {"type": "string", "const": "google_workspace"},
    "auth_mode": {"type": "string", "enum": ["none", "oauth_user", "oauth_desktop_deferred", "service_account", "service_account_domain_wide_delegation", "workspace_marketplace_deferred", "api_key_public"]},
    "auth_status": {"type": "string", "enum": ["unavailable", "unauthenticated", "authenticated", "expired", "revoked", "error"]},
    "account_hash": {"type": "string", "description": "SHA-256 of Google account identifier."},
    "customer_hash": {"type": "string", "description": "SHA-256 of Google Workspace customer ID. Empty if not applicable."},
    "domain_hash": {"type": "string", "description": "SHA-256 of domain name. Empty if not applicable."},
    "subject_hashes": {"type": "array", "items": {"type": "string", "minLength": 64, "maxLength": 64}, "description": "SHA-256 hashes of user subject emails authorized via delegation."},
    "domain_wide_delegation_authorized": {"type": "boolean", "description": "True if domain-wide delegation is explicitly authorized by super admin."},
    "scope_grants": {"type": "array", "minItems": 1, "items": {
      "type": "object",
      "required": ["scope_id", "scope_sensitivity", "grant_status", "grant_hash", "granted_at"],
      "properties": {
        "scope_id": {"type": "string", "description": "Google OAuth scope URL (e.g., https://www.googleapis.com/auth/gmail.readonly)."},
        "scope_sensitivity": {"type": "string", "enum": ["non_sensitive", "sensitive", "restricted", "admin_restricted", "unknown"]},
        "grant_status": {"type": "string", "enum": ["active", "expired", "revoked"]},
        "access_level": {"type": "string", "enum": ["read", "write", "admin"]},
        "grant_hash": {"type": "string", "minLength": 64, "maxLength": 64},
        "granted_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }},
    "token_storage_authority": {"type": "string", "enum": ["none", "environment", "keychain_future", "user_supplied_runtime", "forbidden_json_file"]},
    "token_material_present": {"type": "boolean"},
    "token_material_stored": {"type": "boolean", "const": false},
    "generated_at": {"type": "string", "format": "date-time"},
    "redaction_status": {"type": "string", "enum": ["clean", "redacted", "not_applicable"]}
  },
  "additionalProperties": false
}
