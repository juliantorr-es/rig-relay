{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.integration.permission_policy.v1.schema.json",
  "title": "Integration Permission Policy v1",
  "description": "Structured permission/scopes policy for integration providers. Governs least-privilege defaults, scope justification, mutation gating, and telemetry safety across all integrations. This is the canonical authority for what scopes/permissions integrations may request and under what conditions.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "generated_at",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.integration.permission_policy.v1"
    },
    "policy_id": {
      "type": "string",
      "description": "Unique policy identifier."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string"
    },
    "global_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "description", "enforcement"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": { "type": "string" },
          "enforcement": {
            "type": "string",
            "enum": ["hard_block", "warn", "audit_only"]
          },
          "rationale": { "type": "string" },
          "applies_to_providers": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "description", "enforcement", "applies_to_providers"],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": { "type": "string" },
          "enforcement": {
            "type": "string",
            "enum": ["hard_block", "warn", "audit_only"]
          },
          "applies_to_providers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "affected_capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_condition": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "provider_specific_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["rule_id", "description", "enforcement"],
          "properties": {
            "rule_id": { "type": "string" },
            "description": { "type": "string" },
            "enforcement": {
              "type": "string",
              "enum": ["hard_block", "warn", "audit_only"]
            },
            "rationale": { "type": "string" }
          }
        }
      }
    },
    "scope_allowlist": {
      "type": "object",
      "description": "Per-provider allowlist of permitted OAuth scopes. Any scope not in the allowlist is blocked.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["scope", "justification_required"],
          "properties": {
            "scope": { "type": "string" },
            "justification_required": { "type": "boolean" },
            "maximum_grant": { "type": "string" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "mutation_gate_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "description"],
        "properties": {
          "rule_id": { "type": "string" },
          "description": { "type": "string" },
          "requires_profile_unlock": { "type": "boolean" },
          "requires_explicit_approval": { "type": "boolean" },
          "requires_authorization_receipt": { "type": "boolean" }
        }
      }
    }
  }
}
