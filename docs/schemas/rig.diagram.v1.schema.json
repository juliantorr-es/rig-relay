{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.diagram.v1.schema.json",
  "title": "Rig Diagram Specification",
  "description": "Schema-governed diagram specification for static site asset generation from JSON, JSONL, or CSV data sources.",
  "type": "object",
  "required": ["schema_version", "diagram_id", "title", "kind"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.diagram.v1"
    },
    "diagram_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated", "archived"]
    },
    "kind": {
      "type": "string",
      "enum": ["flow", "state_machine", "timeline", "matrix", "dependency_graph", "risk_map", "architecture_map"]
    },
    "source_data": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["inline", "json", "jsonl", "csv"]
        },
        "path": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "orientation": {
          "type": "string",
          "enum": ["vertical", "horizontal"]
        },
        "desktop": {
          "type": "object",
          "properties": {
            "width": {"type": "number"},
            "height": {"type": "number"}
          }
        },
        "tablet": {
          "type": "object",
          "properties": {
            "width": {"type": "number"},
            "height": {"type": "number"}
          }
        },
        "mobile": {
          "type": "object",
          "properties": {
            "width": {"type": "number"},
            "height": {"type": "number"}
          }
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["active", "completed", "pending", "error", "inactive"]
          },
          "description": {"type": "string"},
          "group": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": {"type": "string"},
          "to": {"type": "string"},
          "label": {"type": "string"},
          "style": {
            "type": "string",
            "enum": ["solid", "dashed", "dotted"]
          }
        },
        "additionalProperties": false
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {"type": "string"}
      }
    },
    "columns": {
      "type": "array",
      "items": {"type": "string"}
    },
    "marks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string"},
          "field": {"type": "string"},
          "color": {"type": "string"},
          "label": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "legend": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {"type": "string"},
              "color": {"type": "string"},
              "shape": {"type": "string"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "accessibility": {
      "type": "object",
      "properties": {
        "alt": {"type": "string"},
        "summary": {"type": "string"},
        "long_description": {"type": "string"}
      },
      "additionalProperties": false
    },
    "responsive": {
      "type": "object",
      "properties": {
        "min_touch_target_px": {"type": "number"},
        "allow_horizontal_scroll": {"type": "boolean"},
        "mobile_simplification": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "generated_from": {"type": "string"}
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    }
  },
  "additionalProperties": false
}
