{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json-schema.org/rig.local_inference_runtime_evaluation.v1",
  "title": "Local Inference Runtime Evaluation Report",
  "description": "Architecture evaluation of local inference runtime integration for Rig Relay. Covers provider contract design, capability probing, benchmark strategy, routing policy, and schemas for vLLM, llama.cpp, and MLX-family runtimes.",
  "type": "object",
  
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "evaluation_summary",
    "runtime_research",
    "recommended_abstraction",
    "proposed_schemas",
    "proposed_code_artifacts",
    "deferred_work",
    "out_of_scope_risks"
  ],
  "properties": {
    "schema_version": {
      "const": "rig.local_inference_runtime_evaluation.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^eval_[a-f0-9]{16}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "evaluation_summary": {
      "type": "object",
      
      "required": ["recommendation", "confidence", "key_findings", "gating_factors"],
      "properties": {
        "recommendation": {
          "type": "string",
          "enum": ["PROMOTE", "HOLD", "REJECT", "NEEDS_RESEARCH"]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "key_findings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gating_factors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "runtime_research": {
      "type": "object",
      
      "required": ["vllm", "llama_cpp", "mlx_family"],
      "properties": {
        "vllm": {
          "type": "object",
          "required": ["canonical_name", "openai_compatible", "platform_primary", "capability_matrix", "maturity_assessment"],
          "properties": {
            "canonical_name": { "const": "vLLM" },
            "openai_compatible": { "const": true },
            "platform_primary": { "type": "string" },
            "capability_matrix": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["supported", "partial", "unsupported", "unknown"] }
            },
            "maturity_assessment": { "type": "string" }
          }
        },
        "llama_cpp": {
          "type": "object",
          
          "required": ["canonical_name", "openai_compatible", "platform_primary", "capability_matrix", "maturity_assessment"],
          "properties": {
            "canonical_name": { "const": "llama.cpp" },
            "openai_compatible": { "const": true },
            "platform_primary": { "type": "string" },
            "capability_matrix": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["supported", "partial", "unsupported", "unknown"] }
            },
            "maturity_assessment": { "type": "string" }
          }
        },
        "mlx_family": {
          "type": "object",
          
          "required": ["canonical_name", "openai_compatible", "platform_primary", "capability_matrix", "maturity_assessment", "server_status"],
          "properties": {
            "canonical_name": { "const": "MLX-LM (mlx-omni-server not found)" },
            "openai_compatible": { "const": false },
            "platform_primary": { "type": "string" },
            "server_status": { "type": "string" },
            "capability_matrix": {
              "type": "object",
              "additionalProperties": { "type": "string", "enum": ["supported", "partial", "unsupported", "unknown"] }
            },
            "maturity_assessment": { "type": "string" }
          }
        }
      }
    },
    "recommended_abstraction": {
      "type": "object",
      
      "required": [
        "canonical_interface",
        "runtime_descriptor_model",
        "capability_probe_contract",
        "routing_policy_dimensions",
        "what_remains_runtime_specific"
      ],
      "properties": {
        "canonical_interface": { "type": "string" },
        "runtime_descriptor_model": {
          "type": "object",
          
          "properties": {
            "key_fields": { "type": "array", "items": { "type": "string" } },
            "enum_values": { "type": "array", "items": { "type": "string" } },
            "schema_name": { "type": "string" }
          }
        },
        "capability_probe_contract": {
          "type": "object",
          
          "properties": {
            "probe_dimensions": { "type": "array", "items": { "type": "string" } },
            "schema_name": { "type": "string" }
          }
        },
        "routing_policy_dimensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "what_remains_runtime_specific": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "proposed_schemas": {
      "type": "array",
      "items": {
        "type": "object",
        
        "required": ["schema_name", "purpose", "implementation_status"],
        "properties": {
          "schema_name": { "type": "string" },
          "purpose": { "type": "string" },
          "implementation_status": { "type": "string", "enum": ["implemented", "planned", "deferred"] }
        }
      }
    },
    "proposed_code_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        
        "required": ["artifact_path", "purpose", "implementation_status"],
        "properties": {
          "artifact_path": { "type": "string" },
          "purpose": { "type": "string" },
          "implementation_status": { "type": "string", "enum": ["implemented", "planned", "deferred"] }
        }
      }
    },
    "deferred_work": {
      "type": "array",
      "items": { "type": "string" }
    },
    "out_of_scope_risks": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
