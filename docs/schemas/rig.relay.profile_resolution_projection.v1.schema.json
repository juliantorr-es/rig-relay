{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.profile_resolution_projection.v1.schema.json",
  "title": "Profile Resolution Projection v1",
  "description": "Canonical schema for a desktop cockpit projection of profile resolution state. Content-light: never includes raw prompts, file contents, secrets, or model outputs.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.profile_resolution_projection.v1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of generation"
    },
    "current_profile": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "profile_id": { "type": "string" },
            "display_name": { "type": "string" },
            "evaluation_status": { "type": "string" },
            "confidence": { "type": "string" },
            "provider": { "type": "string" },
            "model_id": { "type": "string" },
            "task_role": { "type": "string" },
            "is_user_override": { "type": "boolean" },
            "context_envelope_strategy": { "type": "string" },
            "tool_dialect_strategy": { "type": "string" }
          },
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "available_profile_count": {
      "type": "integer"
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profile_id": { "type": "string" },
          "display_name": { "type": "string" },
          "description": { "type": "string" },
          "supported_roles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evaluation_status": { "type": "string" },
          "provider_families": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    },
    "resolution_history": {
      "type": "array",
      "description": "Last N resolutions (content-light)",
      "items": { "type": "object" }
    },
    "evaluation_summary": {
      "type": "object",
      "description": "Counts of profiles by evaluation status",
      "additionalProperties": { "type": "integer" }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "available_profile_count"
  ],
  "additionalProperties": false
}
