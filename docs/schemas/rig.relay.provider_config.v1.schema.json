{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://rig-relay.local/schemas/rig.relay.provider_config.v1.schema.json",
    "title": "Provider Configuration",
    "description": "Content-light provider configuration metadata. Never contains raw API keys.",
    "type": "object",
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "rig.relay.provider_config.v1"
        },
        "provider": {
            "type": "string",
            "enum": ["openai", "anthropic", "google", "openrouter", "deepseek"]
        },
        "display_name": {
            "type": "string"
        },
        "configured": {
            "type": "boolean"
        },
        "key_source": {
            "type": "string",
            "enum": ["env", "keychain", "dev_file", "missing"]
        },
        "key_fingerprint": {
            "type": "string",
            "description": "SHA256 prefix hash of the API key. Not the key itself."
        },
        "base_url": {
            "type": "string",
            "description": "Optional base URL override for the provider API."
        },
        "default_model": {
            "type": "string",
            "description": "Default model identifier for this provider."
        },
        "warnings": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": ["schema_version", "provider", "configured", "key_source"],
    "additionalProperties": false
}
