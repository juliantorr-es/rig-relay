{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/opencode.prepublication_review.v1.schema.json",
  "title": "OpenCode Prepublication Review v1",
  "description": "Canonical review artifact that admits or blocks a checkpoint publication.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "created_at",
    "checkpoint_commit_receipt_sha256",
    "candidate_packet_digest",
    "disposition",
    "reviewer_name",
    "review_notes",
    "content_light"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "opencode.prepublication_review.v1" },
    "artifact_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "checkpoint_commit_receipt_sha256": { "type": "string" },
    "candidate_packet_digest": { "type": "string" },
    "disposition": {
      "type": "string",
      "enum": [
        "prepublication_admitted",
        "prepublication_repair_required",
        "prepublication_blocked_external_dependency"
      ]
    },
    "reviewer_name": { "type": "string" },
    "review_notes": { "type": "array", "items": { "type": "string" } },
    "content_light": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
