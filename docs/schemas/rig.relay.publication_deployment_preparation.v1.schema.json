{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/juliantorr-es/rig-relay/schemas/rig.relay.publication_deployment_preparation.v1",
  "title": "Publication Deployment Preparation",
  "description": "Schema for deployment readiness inspection result before any external mutation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.publication_deployment_preparation.v1"
    },
    "preparation_id": { "type": "string" },
    "operation_id": { "type": "string" },
    "ready_to_deploy": { "type": "boolean" },
    "compilation_valid": { "type": "boolean" },
    "safety_valid": { "type": "boolean" },
    "preview_evidence_valid": { "type": "boolean" },
    "content_digest": { "type": "string" },
    "preview_evidence_digest": { "type": "string" },
    "pages_ready": { "type": "boolean" },
    "pages_site_exists": { "type": "boolean" },
    "pages_requires_configure": { "type": "boolean" },
    "pages_target_repo": { "type": "string" },
    "pages_source_branch": { "type": "string" },
    "static_content_available": { "type": "boolean" },
    "static_content_digest": { "type": "string" },
    "authorization_required": { "type": "boolean" },
    "authorization_request_digest": { "type": "string" },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "suggested_action": { "type": "string" },
    "prepared_at": { "type": "string" },
    "evidence_digest": { "type": "string" }
  },
  "required": [
    "schema_version", "preparation_id", "operation_id",
    "ready_to_deploy", "authorization_required"
  ],
  "additionalProperties": false
}
