{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rig.relay.native.update_evidence.v1",
  "title": "Native Update Delivery Evidence",
  "description": "Content-light update lifecycle evidence. No raw binaries or appcasts.",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "rig.relay.native.update_evidence.v1" },
    "current_version": { "type": "string" },
    "latest_version": { "type": ["string", "null"] },
    "update_available": { "type": "boolean" },
    "status": {
      "type": "string",
      "enum": ["up_to_date", "update_available", "downloading", "downloaded", "ready_to_install", "installing", "installed", "failed", "rolled_back"]
    },
    "feed_url": { "type": ["string", "null"] },
    "download_sha256": { "type": ["string", "null"] },
    "ed_signature_verified": { "type": "boolean" },
    "last_check_at": { "type": ["string", "null"], "format": "date-time" },
    "installed_at": { "type": ["string", "null"], "format": "date-time" },
    "rolled_back_at": { "type": ["string", "null"], "format": "date-time" },
    "rollback_version": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["schema_version", "current_version", "update_available", "status"],
  "additionalProperties": false
}
