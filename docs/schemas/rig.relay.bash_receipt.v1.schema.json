{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.bash_receipt.v1.schema.json",
  "title": "Rig Relay Bash Receipt v1",
  "description": "Content-light receipt for a bash invocation. Contains no raw stdout/stderr \u2014 only metadata, byte counts, SHA256 hashes, exit code, and timing.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "rig.relay.bash_receipt.v1"
      ]
    },
    "command": {
      "type": "string",
      "description": "The command that was executed"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "timed_out",
        "refused",
        "truncated"
      ],
      "description": "Outcome of the command execution"
    },
    "exit_code": {
      "type": "integer",
      "description": "Process exit code"
    },
    "duration_ms": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Wall-clock duration in milliseconds"
    },
    "stdout_bytes": {
      "type": "integer",
      "description": "Total stdout bytes"
    },
    "stderr_bytes": {
      "type": "integer",
      "description": "Total stderr bytes"
    },
    "stdout_truncated": {
      "type": "boolean",
      "description": "Whether stdout was truncated"
    },
    "stderr_truncated": {
      "type": "boolean",
      "description": "Whether stderr was truncated"
    },
    "stdout_sha256": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "SHA256 hex digest of stdout content, if any"
    },
    "stderr_sha256": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "SHA256 hex digest of stderr content, if any"
    },
    "error_kind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "nonzero_exit",
            "timeout",
            "refused",
            "internal_error"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Structured error classification"
    },
    "refusal_reason": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Reason for refusal, if refused"
    },
    "reroute": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "was_rerouted": {"type": "boolean"},
            "raw_bash_skipped": {"type": "boolean"},
            "original_command_category": {
              "oneOf": [
                {"type": "string", "enum": ["file_read", "search", "git", "python_subprocess", "unknown"]},
                {"type": "null"}
              ]
            },
            "original_command_hash": {
              "oneOf": [{"type": "string"}, {"type": "null"}]
            },
            "rerouted_tool_name": {
              "oneOf": [{"type": "string"}, {"type": "null"}]
            },
            "reroute_reason": {
              "oneOf": [{"type": "string"}, {"type": "null"}]
            },
            "permission_decision": {
              "oneOf": [{"type": "string", "enum": ["allowed", "denied", "not_checked"]}, {"type": "null"}]
            },
            "safety_class": {
              "oneOf": [{"type": "string", "enum": ["safe_reroute", "risky_reroute", "blocked"]}, {"type": "null"}]
            },
            "final_outcome": {
              "oneOf": [{"type": "string", "enum": ["rerouted", "refused_reroute", "not_rerouted"]}, {"type": "null"}]
            },
            "refusal_reason": {
              "oneOf": [{"type": "string"}, {"type": "null"}]
            },
            "matched_pattern": {
              "oneOf": [{"type": "string"}, {"type": "null"}]
            },
            "redaction_status": {"type": "string"}
          },
          "required": ["was_rerouted", "raw_bash_skipped", "redaction_status"]
        },
        {"type": "null"}
      ],
      "description": "Bash rerouting transparency metadata. Records whether the command was rerouted to a safer tool, why, and the outcome."
    }
  },
  "required": [
    "command",
    "status",
    "exit_code",
    "reroute"
  ],
  "additionalProperties": false
}
