{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.otel.ingest_report.v1.schema.json",
  "title": "Rig OTel Ingest Report",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "generated_at",
    "raw_capture_manifest_path",
    "normalized_events_path",
    "tool_behavior_summary_path",
    "raw_input_sha256",
    "normalized_output_sha256",
    "schema_validation_results",
    "redaction_results",
    "warnings",
    "errors",
    "ingest_verdict"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.otel.ingest_report.v1"
    },
    "run_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "raw_capture_manifest_path": {
      "type": "string"
    },
    "normalized_events_path": {
      "type": "string"
    },
    "tool_behavior_summary_path": {
      "type": "string"
    },
    "raw_input_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "normalized_output_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schema_validation_results": {
      "type": "object",
      "required": ["raw_capture_manifest", "normalized_events", "tool_behavior_summary", "ingest_report"],
      "properties": {
        "raw_capture_manifest": {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "normalized_events": {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "tool_behavior_summary": {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "ingest_report": {
          "type": "object",
          "required": ["valid", "errors"],
          "properties": {
            "valid": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "redaction_results": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ingest_verdict": {
      "type": "string",
      "enum": ["pass", "hold", "fail"]
    }
  },
  "additionalProperties": false
}

