{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.step_up_authorization_request.v1.schema.json",
  "title": "Step-Up Authorization Request v1",
  "description": "A request for step-up authorization for a high-authority Rig Relay action. Issued before the user is prompted to verify.",
  "type": "object",
  "required": [
    "schema_version",
    "authorization_id",
    "requested_at",
    "action",
    "requested_method",
    "allowed_methods",
    "expires_at",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.step_up_authorization_request.v1"
    },
    "authorization_id": {
      "type": "string",
      "description": "Unique authorization request identifier."
    },
    "requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of request creation."
    },
    "action": {
      "type": "string",
      "enum": [
        "remote_upload.confirm",
        "telemetry.share_level.change",
        "checkpoint.commit",
        "spawn.execute",
        "fleet.execute",
        "lease_cleanup.archive",
        "lease_cleanup.remove",
        "credentials.configure",
        "update.restart_now"
      ],
      "description": "The high-authority action requiring authorization."
    },
    "action_scope": {
      "type": "object",
      "properties": {
        "target_sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "SHA256 of the target resource (e.g. bundle, lease file, checkpoint)."
        },
        "target_path": {
          "type": "string",
          "description": "Path to the target resource (content-light, path only)."
        }
      },
      "additionalProperties": false
    },
    "requested_method": {
      "type": "string",
      "enum": ["none_dev_only", "local_system_auth", "passkey_webauthn", "remote_passkey"],
      "description": "The requested authorization method."
    },
    "allowed_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["none_dev_only", "local_system_auth", "passkey_webauthn", "remote_passkey"]
      },
      "minItems": 1,
      "description": "Allowed authorization methods for this action."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp after which the request expires."
    },
    "reason": {
      "type": "string",
      "description": "Human-readable reason for the authorization request."
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
