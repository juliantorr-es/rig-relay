{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rig Fleet Queue Event",
  "description": "A single event in the append-only queue event log. Content-light: no raw prompts, stdout, content, diffs, patches, secrets, argv, snippets, or file contents.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "queue_item_id",
    "event_kind",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.fleet.queue_event.v1"
    },
    "event_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for this event."
    },
    "queue_item_id": {
      "type": "string",
      "description": "The queue item this event refers to."
    },
    "event_kind": {
      "type": "string",
      "enum": ["enqueued", "cancelled", "status_changed", "superseded_by"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mission_id": {
      "type": ["string", "null"]
    },
    "agent_id": {
      "type": ["string", "null"]
    },
    "payload": {
      "type": "object",
      "description": "Content-light event payload (status, reason, etc.)."
    }
  },
  "additionalProperties": false
}
