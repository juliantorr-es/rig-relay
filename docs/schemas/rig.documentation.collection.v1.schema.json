{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.documentation.collection.v1.schema.json",
  "title": "Rig Documentation Collection",
  "description": "A named collection of documentation pages for the site manifest.",
  "type": "object",
  "required": [
    "collection_id",
    "title",
    "documents"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.documentation.collection.v1"
    },
    "collection_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document_id",
          "path"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "title_override": {
            "type": "string"
          }
        }
      }
    }
  }
}
