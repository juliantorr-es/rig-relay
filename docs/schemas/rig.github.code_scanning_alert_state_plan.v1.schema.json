{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.github.code_scanning_alert_state_plan.v1.schema.json",
  "title": "Code Scanning Alert State Plan v1",
  "description": "Security lifecycle alert state plan. Models permissible alert state transitions (fix, false-positive, wont-fix, dismissal, direct-update) with required evidence, permissions, and approvals per path.",
  "type": "object",
  "required": [
    "schema_version",
    "alert_number",
    "current_state",
    "paths",
    "gates_passed",
    "blocked_reasons",
    "recommended_path",
    "recommended_action",
    "generated_at"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.github.code_scanning_alert_state_plan.v1" },
    "alert_number": { "type": "integer", "minimum": 1 },
    "current_state": { "type": "string" },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/definitions/alert_path" }
    },
    "gates_passed": { "type": "boolean" },
    "blocked_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_path": { "type": "string" },
    "recommended_action": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true,
  "definitions": {
    "alert_path": {
      "type": "object",
      "required": ["path_id", "description", "required_evidence", "required_permissions", "required_approval", "remote_mutation"],
      "properties": {
        "path_id": { "type": "string" },
        "description": { "type": "string" },
        "required_evidence": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_approval": { "type": "string", "enum": ["human_or_security_team"] },
        "remote_mutation": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
