{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.desktop_projection.v1.schema.json",
  "title": "Desktop Projection v1",
  "description": "Content-light cockpit projection for the read-only desktop shell. Aggregates available Rig Relay build artifacts into a single compact snapshot. All field names are drawn from actual artifact schemas. Missing sources are represented as available=false, never invented.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "app_version",
    "source_status",
    "current_state",
    "queue",
    "dataset",
    "semantic_snippets",
    "telemetry_bundle",
    "update",
    "storage",
    "warnings",
    "read_only_actions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.desktop_projection.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the projection was built."
    },
    "app_version": {
      "type": "string",
      "description": "Current application version (e.g. 0.1.0a1)."
    },
    "source_status": {
      "type": "object",
      "description": "Which data sources were found vs missing.",
      "patternProperties": {
        "^[a-z_]+$": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "current_state": {
      "type": "object",
      "description": "Summary from current_state.json (generated by scripts/rig_relay_current_state.py).",
      "properties": {
        "available": { "type": "boolean" },
        "active_children": { "type": "integer", "minimum": 0 },
        "max_children": { "type": "integer", "minimum": 0 },
        "available_child_slots": { "type": "integer", "minimum": 0 },
        "active_writers": { "type": "integer", "minimum": 0 },
        "active_readers": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "integer", "minimum": 0 },
        "stale_leases": { "type": "integer", "minimum": 0 },
        "checkpoint_commits": { "type": "integer", "minimum": 0 },
        "checkpoint_refusals": { "type": "integer", "minimum": 0 },
        "generated_at": { "type": "string" }
      },
      "required": ["available"]
    },
    "queue": {
      "type": "object",
      "description": "Summary from queue planner (generated by scripts/rig_relay_queue_plan.py).",
      "properties": {
        "available": { "type": "boolean" },
        "ready_items": { "type": "integer", "minimum": 0 },
        "blocked_items": { "type": "integer", "minimum": 0 },
        "waiting_items": { "type": "integer", "minimum": 0 },
        "total_items": { "type": "integer", "minimum": 0 }
      },
      "required": ["available"]
    },
    "dataset": {
      "type": "object",
      "description": "Summary from dataset export manifest (build/rig-relay/derived/export_manifest.json) and report.",
      "properties": {
        "available": { "type": "boolean" },
        "exported_at": { "type": "string" },
        "coordination_rows": { "type": "integer", "minimum": 0 },
        "tool_failure_rows": { "type": "integer", "minimum": 0 },
        "provider_perf_rows": { "type": "integer", "minimum": 0 },
        "findings_rows": { "type": "integer", "minimum": 0 },
        "artifact_reuse_rows": { "type": "integer", "minimum": 0 },
        "checkpoint_rows": { "type": "integer", "minimum": 0 },
        "skipped_event_count": { "type": "integer", "minimum": 0 },
        "strict": { "type": "boolean" },
        "datasets_generated": { "type": "boolean" },
        "sessions_observed": { "type": "integer", "minimum": 0 },
        "coordination_events_total": { "type": "integer", "minimum": 0 },
        "tool_calls_total": { "type": "integer", "minimum": 0 }
      },
      "required": ["available"]
    },
    "semantic_snippets": {
      "type": "object",
      "description": "Summary from semantic change snippet export manifest.",
      "properties": {
        "available": { "type": "boolean" },
        "snippet_count": { "type": "integer", "minimum": 0 },
        "skipped_count": { "type": "integer", "minimum": 0 },
        "forbidden_count": { "type": "integer", "minimum": 0 },
        "strict_mode": { "type": "boolean" },
        "remote_sharing_safe": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["available"]
    },
    "telemetry_bundle": {
      "type": "object",
      "description": "Summary from telemetry bundle manifest (if a bundle exists).",
      "properties": {
        "available": { "type": "boolean" },
        "bundle_id": { "type": "string" },
        "share_level": { "type": "string" },
        "status": { "type": "string" },
        "bundle_sha256": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["available"]
    },
    "update": {
      "type": "object",
      "description": "Summary from update status (generated by scripts/rig_relay_update_status.py).",
      "properties": {
        "available": { "type": "boolean" },
        "current_version": { "type": "string" },
        "latest_version": { "type": "string" },
        "update_available": { "type": "boolean" },
        "update_state": { "type": "string" },
        "restart_required": { "type": "boolean" },
        "restart_safe": { "type": "boolean" },
        "blocked_by_active_sessions": { "type": "integer", "minimum": 0 }
      },
      "required": ["available"]
    },
    "storage": {
      "type": "object",
      "description": "Storage lifecycle summary from the build artifact tree (computed by rig_relay.evidence.storage_lifecycle).",
      "properties": {
        "available": { "type": "boolean" },
        "budget_status": {
          "type": "string",
          "enum": ["ok", "warn", "over_budget", "fleet_blocked", "unknown"],
          "description": "Current storage budget status."
        },
        "total_size_mb": {
          "type": "number",
          "minimum": 0,
          "description": "Total size of .build/rig-relay in megabytes."
        },
        "rollup_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of JSONL datasets without corresponding Parquet rollup."
        },
        "prune_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of files older than their retention window."
        },
        "stale_lease_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of stale coordination leases."
        },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Recommended storage lifecycle actions."
        }
      },
      "required": ["available"]
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Non-blocking warnings about missing or degraded data sources."
    },
    "read_only_actions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of read-only action names the cockpit can invoke.",
      "uniqueItems": true
    }
  }
}
