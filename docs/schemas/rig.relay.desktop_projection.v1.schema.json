{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.desktop_projection.v1.schema.json",
  "title": "Desktop Projection v1",
  "description": "Content-light cockpit projection for the read-only desktop shell. Aggregates available Rig Relay build artifacts into a single compact snapshot. All field names are drawn from actual artifact schemas. Missing sources are represented as available=false, never invented.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "app_version",
    "source_status",
    "current_state",
    "queue",
    "dataset",
    "semantic_snippets",
    "telemetry_bundle",
    "update",
    "storage",
    "providers",
    "identity",
    "integrations",
    "warnings",
    "read_only_actions",
    "service_state",
    "resources",
    "spiderweb_topology",
    "security_lifecycle_program",
    "live_mutation_readiness"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.desktop_projection.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the projection was built."
    },
    "app_version": {
      "type": "string",
      "description": "Current application version (e.g. 0.1.0a1)."
    },
    "source_status": {
      "type": "object",
      "description": "Which data sources were found vs missing.",
      "properties": {
        "integrations": {
          "type": "boolean"
        }
      },
      "patternProperties": {
        "^[a-z_]+$": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "current_state": {
      "type": "object",
      "description": "Summary from current_state.json (generated by scripts/rig_relay_current_state.py).",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "active_children": {
          "type": "integer",
          "minimum": 0
        },
        "max_children": {
          "type": "integer",
          "minimum": 0
        },
        "available_child_slots": {
          "type": "integer",
          "minimum": 0
        },
        "active_writers": {
          "type": "integer",
          "minimum": 0
        },
        "active_readers": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "stale_leases": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_commits": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_refusals": {
          "type": "integer",
          "minimum": 0
        },
        "generated_at": {
          "type": "string"
        }
      },
      "required": [
        "available"
      ]
    },
    "queue": {
      "type": "object",
      "description": "Summary from queue planner (generated by scripts/rig_relay_queue_plan.py).",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "ready_items": {
          "type": "integer",
          "minimum": 0
        },
        "blocked_items": {
          "type": "integer",
          "minimum": 0
        },
        "waiting_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "available"
      ]
    },
    "dataset": {
      "type": "object",
      "description": "Summary from dataset export manifest (build/rig-relay/derived/export_manifest.json) and report.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "exported_at": {
          "type": "string"
        },
        "coordination_rows": {
          "type": "integer",
          "minimum": 0
        },
        "tool_failure_rows": {
          "type": "integer",
          "minimum": 0
        },
        "provider_perf_rows": {
          "type": "integer",
          "minimum": 0
        },
        "findings_rows": {
          "type": "integer",
          "minimum": 0
        },
        "artifact_reuse_rows": {
          "type": "integer",
          "minimum": 0
        },
        "checkpoint_rows": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_event_count": {
          "type": "integer",
          "minimum": 0
        },
        "strict": {
          "type": "boolean"
        },
        "datasets_generated": {
          "type": "boolean"
        },
        "sessions_observed": {
          "type": "integer",
          "minimum": 0
        },
        "coordination_events_total": {
          "type": "integer",
          "minimum": 0
        },
        "tool_calls_total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "available"
      ]
    },
    "semantic_snippets": {
      "type": "object",
      "description": "Summary from semantic change snippet export manifest.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "snippet_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0
        },
        "forbidden_count": {
          "type": "integer",
          "minimum": 0
        },
        "strict_mode": {
          "type": "boolean"
        },
        "remote_sharing_safe": {
          "type": "boolean"
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "available"
      ]
    },
    "telemetry_bundle": {
      "type": "object",
      "description": "Summary from telemetry bundle manifest (if a bundle exists).",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "bundle_id": {
          "type": "string"
        },
        "share_level": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "bundle_sha256": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "available"
      ]
    },
    "update": {
      "type": "object",
      "description": "Summary from update status (generated by scripts/rig_relay_update_status.py).",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "current_version": {
          "type": "string"
        },
        "latest_version": {
          "type": "string"
        },
        "update_available": {
          "type": "boolean"
        },
        "update_state": {
          "type": "string"
        },
        "restart_required": {
          "type": "boolean"
        },
        "restart_safe": {
          "type": "boolean"
        },
        "blocked_by_active_sessions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "available"
      ]
    },
    "storage": {
      "type": "object",
      "description": "Storage lifecycle summary from the build artifact tree (computed by rig_relay.evidence.storage_lifecycle).",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "budget_status": {
          "type": "string",
          "enum": [
            "ok",
            "warn",
            "over_budget",
            "fleet_blocked",
            "unknown"
          ],
          "description": "Current storage budget status."
        },
        "total_size_mb": {
          "type": "number",
          "minimum": 0,
          "description": "Total size of .build/rig-relay in megabytes."
        },
        "rollup_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of JSONL datasets without corresponding Parquet rollup."
        },
        "prune_candidate_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of files older than their retention window."
        },
        "stale_lease_count": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of stale coordination leases."
        },
        "recommendations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recommended storage lifecycle actions."
        }
      },
      "required": [
        "available"
      ]
    },
    "providers": {
      "type": "object",
      "description": "Content-light provider status summary. Merges env-var and dev-file keys (env vars take precedence). No raw API keys. valid_count tracks providers with confirmed real network validation.",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "configured": {
          "type": "integer",
          "minimum": 0
        },
        "valid_count": {
          "type": "integer",
          "minimum": 0
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "configured": {
                "type": "boolean"
              },
              "key_source": {
                "type": "string"
              },
              "key_fingerprint": {
                "type": "string"
              },
              "base_url": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "default_model": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": "string",
                "description": "One of: valid, skipped, unknown, invalid, error"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "provider",
              "display_name",
              "configured",
              "key_source",
              "key_fingerprint",
              "status"
            ]
          },
          "description": "List of content-light provider entries."
        }
      },
      "required": [
        "total",
        "configured",
        "valid_count",
        "providers"
      ]
    },
    "identity": {
      "type": "object",
      "description": "Content-light identity provider status. No raw tokens, access codes, or secrets.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "any_signed_in": {
          "type": "boolean"
        },
        "providers": {
          "type": "object",
          "description": "Provider name to status map. Values are content-light summaries.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "description": "One of: signed_out, pending, signed_in, error, expired, cancelled"
              },
              "display_name": {
                "type": "string"
              },
              "scopes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "expires_at": {
                "type": "string"
              }
            },
            "required": ["status"]
          }
        }
      },
      "required": ["available", "any_signed_in", "providers"]
    },
    "integrations": {
      "type": "object",
      "description": "Content-light integration provider status from manifests and identity. No raw tokens or private content.",
      "properties": {
        "available": {
          "type": "boolean"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "connected": {
          "type": "integer",
          "minimum": 0
        },
        "configured": {
          "type": "integer",
          "minimum": 0
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider_id", "display_name", "connection_state"],
            "properties": {
              "provider_id": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              },
              "auth_kind": {
                "type": "string"
              },
              "connection_state": {
                "type": "string",
                "enum": ["not_configured", "disconnected", "auth_required", "connected", "degraded", "error"]
              },
              "profile_gate_required": {
                "type": "boolean"
              },
              "account_id_hash": {
                "type": "string"
              },
              "granted_scopes": {
                "type": "array",
                "items": { "type": "string" }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["capability_id", "display_name", "kind"],
                  "properties": {
                    "capability_id": { "type": "string" },
                    "display_name": { "type": "string" },
                    "kind": {
                      "type": "string",
                      "enum": ["read", "write", "observe", "webhook_ingest"]
                    },
                    "gated": { "type": "boolean" },
                    "profile_gate_required": { "type": "boolean" },
                    "available": { "type": "boolean" },
                    "requires_approval": { "type": "boolean" },
                    "mcp_acp_exposable": { "type": "boolean" }
                  }
                }
              },
              "last_checked_at": { "type": "string" },
              "degraded_reason": { "type": "string" },
              "warnings": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      },
      "required": ["available"]
    },
    "warnings": {
      "type": "array",
      "description": "Non-blocking warnings about missing or degraded data sources.",
      "items": { "type": "string" }
    },
    "resources": {
      "type": "object",
      "description": "Resource projection snapshot from event fabric. Read-side only.",
      "properties": {
        "available": {"type": "boolean"},
        "schema_version": {"type": "string"},
        "bridge_backend_health": {"type": "string"},
        "bridge_status_age_ms": {"type": "integer"},
        "projection_freshness": {"type": "string"},
        "reconnect_pressure": {"type": "string"},
        "event_queue_pressure": {"type": "string"},
        "consumer_error_count": {"type": "integer"},
        "github_rate_limit_health": {"type": "string"},
        "test_validation_pressure": {"type": "string"},
        "recommended_scheduling_hints": {"type": "array", "items": {"type": "string"}},
        "degraded_reasons": {"type": "array", "items": {"type": "string"}},
        "redaction_status": {"type": "string"}
      },
      "required": ["available"]
    },
    "read_only_actions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of read-only action names the cockpit can invoke.",
      "uniqueItems": true
    },
    "service_state": {
      "type": "object",
      "description": "Local control-plane service state and profile summary. Content-light.",
      "properties": {
        "available": { "type": "boolean" },
        "service_state": { "type": "string" },
        "profile_exists": { "type": "boolean" },
        "profile_state": { "type": "string" },
        "local_auth_enabled": { "type": "boolean" },
        "passkey_registered": { "type": "boolean" },
        "telemetry_mode": { "type": "string" }
      },
      "required": ["available"]
    },
    "profile_readme_lane": {
      "type": "object",
      "description": "Profile README publish lane projection. Content-light summary of 4 governance artifacts.",
      "properties": {
        "available": {"type": "boolean"},
        "owner": {"type": "string"},
        "mutation_lane_id": {"type": "string"},
        "operation_mode": {"type": "string"},
        "publish_gate_status": {"type": "string"},
        "blocked_reasons": {"type": "array", "items": {"type": "string"}},
        "gates": {"type": "array", "items": {"type": "object", "properties": {"gate": {"type": "string"}, "passed": {"type": "boolean"}, "detail": {"type": "string"}}}},
        "planned_steps": {"type": "array", "items": {"type": "object", "properties": {"step": {"type": "integer"}, "operation": {"type": "string"}, "permission": {"type": "string"}, "description": {"type": "string"}}}},
        "permissions": {"type": "object"},
        "preview": {"type": "object"},
        "permission_audit": {"type": "object"},
        "source_artifacts": {"type": "object"},
        "publish_disabled": {"type": "boolean"},
        "publish_disabled_reasons": {"type": "array", "items": {"type": "string"}}
      },
      "required": ["available"]
    },
    "security_lifecycle_program": {
      "type": "object",
      "description": "Content-light GitHub security lifecycle program projection from governance artifacts. No raw source contents, diffs, or API payloads.",
      "properties": {
        "available": { "type": "boolean" },
        "status": { "type": "string" },
        "phase_status": { "type": "string" },
        "queue_summary": {
          "type": "object",
          "properties": {
            "total_artifacts": { "type": "integer", "minimum": 0 },
            "present_count": { "type": "integer", "minimum": 0 },
            "missing_count": { "type": "integer", "minimum": 0 }
          }
        },
        "selected_alert_summary": {
          "type": "object",
          "properties": {
            "total_stages": { "type": "integer", "minimum": 0 },
            "stages_present": { "type": "integer", "minimum": 0 },
            "current_stage_count": { "type": "integer", "minimum": 0 },
            "blocked_stage_count": { "type": "integer", "minimum": 0 }
          }
        },
        "current_stage": { "type": "string" },
        "next_safe_action": { "type": "string" },
        "mutation_status": {
          "type": "object",
          "properties": {
            "remote_mutation": { "type": "boolean" },
            "local_mutation": { "type": "boolean" }
          }
        },
        "approval_status": { "type": "string" },
        "pr_lifecycle_state": { "type": "string" },
        "alert_lifecycle_state": { "type": "string" },
        "blocked_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "permission_summary": {
          "type": "object",
          "properties": {
            "gates_passed": { "type": "integer", "minimum": 0 },
            "gates_total": { "type": "integer", "minimum": 0 },
            "verdict": { "type": "string" },
            "read_permissions": { "type": "array", "items": { "type": "string" } },
            "mutation_permissions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string" }
            }
          }
        },
        "event_fabric_summary": {
          "type": "object",
          "properties": {
            "event_count": { "type": "integer", "minimum": 0 },
            "active_strands": { "type": "integer", "minimum": 0 }
          }
        },
        "spiderweb_topology_summary": {
          "type": "object",
          "properties": {
            "node_count": { "type": "integer", "minimum": 0 },
            "edge_count": { "type": "integer", "minimum": 0 },
            "active_strands": { "type": "integer", "minimum": 0 }
          }
        },
        "raw_payloads_exposed": { "type": "boolean" },
        "redaction_status": { "type": "string" }
      },
      "required": ["available"]
    },
    "live_mutation_readiness": {
      "type": "object",
      "description": "Content-light live mutation readiness projection from governance artifacts. No raw source contents, tokens, or API payloads.",
      "properties": {
        "available": { "type": "boolean" },
        "live_mutation_readiness_status": { "type": "string" },
        "operator_checklist_status": { "type": "string" },
        "runbook_status": { "type": "string" },
        "required_flags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "required_permissions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "readiness_gates": {
          "type": "array",
          "items": { "type": "string" }
        },
        "blocked_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "next_safe_action": { "type": "string" },
        "expected_live_operations": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deferred_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rollback_guidance_summary": { "type": "string" },
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "present": { "type": "boolean" },
              "sha256": { "type": "string" }
            }
          }
        },
        "raw_payloads_exposed": { "type": "boolean" },
        "redaction_status": { "type": "string" }
      },
      "required": ["available"]
    },
    "integrity": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional projection integrity assessment. Null when no receipt records are available or integrity has not been checked.",
      "properties": {
        "schema_version": {
          "type": "string",
          "const": "rig.relay.projection_integrity.v1"
        },
        "integrity_status": {
          "type": "string",
          "enum": [
            "verified",
            "degraded",
            "stale",
            "orphaned",
            "unknown"
          ]
        },
        "contract_status": {
          "type": "string",
          "enum": [
            "satisfied",
            "partial",
            "violated",
            "not_applicable"
          ]
        },
        "violation_count": {
          "type": "integer",
          "minimum": 0
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "stale_receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "orphaned_receipt_count": {
          "type": "integer",
          "minimum": 0
        },
        "authority_backed": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "integrity_status",
        "contract_status",
        "violation_count",
        "violations",
        "checked_at",
        "receipt_count",
        "stale_receipt_count",
        "orphaned_receipt_count",
        "authority_backed"
      ],
      "additionalProperties": false
    },
    "execution_progress": {
      "description": "Optional aggregated runtime execution progress. Present when build_projection is called with runtime stream events. Null when no runtime events are available.",
      "type": ["object", "null"],
      "properties": {
        "schema_version": { "type": "string", "const": "rig.relay.execution_progress_projection.v1" },
        "invocation_id": { "type": ["string", "null"] },
        "lease_id": { "type": ["string", "null"] },
        "request_id": { "type": ["string", "null"] },
        "workspace_id": { "type": ["string", "null"] },
        "worktree_path": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "started_at": { "type": ["string", "null"] },
        "last_event_at": { "type": ["string", "null"] },
        "elapsed_ms": { "type": ["number", "null"] },
        "heartbeat_count": { "type": "integer", "minimum": 0 },
        "warning_count": { "type": "integer", "minimum": 0 },
        "latest_warning_kind": { "type": ["string", "null"] },
        "latest_warning_message": { "type": ["string", "null"] },
        "stdout_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "stderr_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "stdout_truncated": { "type": "boolean" },
        "stderr_truncated": { "type": "boolean" },
        "exit_code": { "type": ["integer", "null"] },
        "error_kind": { "type": ["string", "null"] },
        "refusal_reason": { "type": ["string", "null"] },
        "terminal_event_id": { "type": ["string", "null"] },
        "evidence_sha256": { "type": ["string", "null"] }
      },
      "required": [
        "schema_version",
        "status",
        "heartbeat_count",
        "warning_count",
        "stdout_truncated",
        "stderr_truncated"
      ],
      "additionalProperties": false
    }
  }
}
