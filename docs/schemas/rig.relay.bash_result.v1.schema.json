{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.bash_result.v1.schema.json",
  "title": "Rig Relay Bash Result v1",
  "description": "Schema for a deterministic bash tool execution result. Contains the full stdout/stderr output with truncation metadata.",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "The command that was executed"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure",
        "timed_out",
        "refused",
        "truncated"
      ],
      "description": "Outcome of the command execution"
    },
    "duration_ms": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Wall-clock duration in milliseconds"
    },
    "stdout_bytes": {
      "type": "integer",
      "description": "Total stdout bytes before truncation"
    },
    "stderr_bytes": {
      "type": "integer",
      "description": "Total stderr bytes before truncation"
    },
    "stdout_truncated": {
      "type": "boolean",
      "description": "Whether stdout was truncated"
    },
    "stderr_truncated": {
      "type": "boolean",
      "description": "Whether stderr was truncated"
    },
    "error_kind": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "nonzero_exit",
            "timeout",
            "refused",
            "internal_error"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Structured error classification"
    },
    "refusal_reason": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Reason for refusal, if refused"
    },
    "returncode": {
      "type": "integer",
      "description": "Process return code"
    },
    "stdout": {
      "type": "string",
      "description": "Full stdout output"
    },
    "stderr": {
      "type": "string",
      "description": "Full stderr output"
    }
  },
  "required": [
    "command",
    "status",
    "returncode",
    "stdout",
    "stderr"
  ],
  "additionalProperties": false
}
