{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.enterprise.secrets_config.v1.schema.json",
  "title": "Rig Enterprise Secrets Configuration v1",
  "description": "Secrets backend configuration — content-light descriptor of which backends are active and their connection parameters (no secrets exposed).",
  "type": "object",
  "required": ["schema_version", "generated_at", "backend"],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.enterprise.secrets_config.v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "backend": {
      "type": "string",
      "enum": ["env", "file", "vault", "aws_sm", "gcp_sm"]
    },
    "vault_addr": { "type": "string" },
    "vault_token_configured": { "type": "boolean" },
    "aws_region": { "type": "string" },
    "aws_configured": { "type": "boolean" },
    "gcp_project": { "type": "string" },
    "gcp_configured": { "type": "boolean" },
    "env_file_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "resolved_keys_count": { "type": "integer", "minimum": 0 },
    "unresolved_keys_count": { "type": "integer", "minimum": 0 },
    "content_light": { "type": "boolean", "const": true },
    "raw_secrets_exposed": { "type": "boolean", "const": false },
    "mutation_authority": { "type": "boolean", "const": false }
  },
  "additionalProperties": false
}
