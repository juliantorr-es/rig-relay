{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.security_alert_triage.v1.schema.json",
  "title": "Security Alert Triage v1",
  "description": "Structured evidence for triaging and resolving GitHub Dependabot and CodeQL security alerts.",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "alerts_triaged",
    "overall_assessment"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.security_alert_triage.v1"
    },
    "report_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "alerts_triaged": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_id", "severity", "ecosystem", "package_or_rule", "action_taken", "justification"],
        "properties": {
          "alert_id": { "type": "string" },
          "severity": { "type": "string" },
          "ecosystem": { "type": "string" },
          "package_or_rule": { "type": "string" },
          "action_taken": { "type": "string", "enum": ["upgraded", "patched", "dismissed_false_positive", "dismissed_mitigated", "code_fix"] },
          "justification": { "type": "string" },
          "pull_request": { "type": "string" }
        }
      }
    },
    "overall_assessment": {
      "type": "string",
      "enum": ["all_resolved", "some_pending", "blocked"]
    }
  }
}
