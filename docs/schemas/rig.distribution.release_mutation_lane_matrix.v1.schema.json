{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.distribution.release_mutation_lane_matrix.v1.schema.json",
  "title": "Distribution Release Mutation Lane Matrix v1",
  "type": "object",
  "required": ["schema_version", "generated_at", "content_light", "remote_mutation", "live_network_used_for_product", "remote_mutation_performed", "mutation_lanes", "mutation_lane_count"],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.distribution.release_mutation_lane_matrix.v1" },
    "generated_at": { "type": "string" }, "branch": { "type": ["string", "null"] }, "head": { "type": ["string", "null"] },
    "dirty_files_count": { "type": "integer" },
    "content_light": { "type": "boolean", "const": true },
    "remote_mutation": { "type": "boolean", "const": false },
    "live_network_used_for_product": { "type": "boolean", "const": false },
    "remote_mutation_performed": { "type": "boolean", "const": false },
    "mutation_lanes": { "type": "array", "items": { "type": "object", "required": ["mutation_lane_id", "recommended_initial_state"] } },
    "mutation_lane_count": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": true
}
