{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json-schema.org/rig.local_inference.manual_execution_receipt.v1",
  "title": "Manual Execution Response Receipt",
  "type": "object",
  "required": ["schema_version", "execution_id", "request_id", "generated_at", "status"],
  "properties": {
    "schema_version": { "const": "rig.local_inference.manual_execution_receipt.v1" },
    "execution_id": { "type": "string" },
    "request_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "type": "string", "enum": ["blocked", "executed", "failed", "cancelled", "timed_out", "malformed_response"] },
    "endpoint_hash": { "type": "string" },
    "model_safe_id": { "type": "string" },
    "task_profile": { "type": "string" },
    "request_class": { "type": "string" },
    "approval_id": { "type": "string" },
    "selection_policy_status": { "type": "string" },
    "capability_match_status": { "type": "string" },
    "prompt_sha256": { "type": "string" },
    "prompt_byte_count": { "type": "integer" },
    "completion_sha256": { "type": "string" },
    "completion_byte_count": { "type": "integer" },
    "output_token_count": { "type": "integer" },
    "input_token_count": { "type": "integer" },
    "latency_ms": { "type": "integer" },
    "time_to_first_token_ms": { "type": ["integer", "null"] },
    "error_class": { "type": "string" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "persistence_policy": { "type": "string" },
    "redaction_summary": { "type": "string" },
    "raw_prompt_persisted": { "type": "boolean" },
    "raw_completion_persisted": { "type": "boolean" },
    "automatic_agent_execution": { "type": "boolean" }
  }
}
