{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/juliantorr-es/rig-relay/schemas/rig.relay.opencode_adapter_hardened_tool_spine_v1_plan.v1.schema.json",
  "title": "OpenCode Adapter Hardened Tool Spine v1 Plan v1",
  "description": "Architectural audit and tool adoption plan mapping out the OpenCode Steward adapter to Rig Relay hardened tool spine integration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "mission_title",
    "repository_state",
    "steward_ownership",
    "tool_adoption_matrix",
    "external_harness_gateway",
    "opencode_integration_stages",
    "steward_observation_receipt_alignment",
    "context_assembler_integration",
    "targeted_tests_and_classifications",
    "dependencies_and_telemetry_implications",
    "current_vs_next_implementation_comparison",
    "remaining_seams_and_deferrals"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.relay.opencode_adapter_hardened_tool_spine_v1_plan.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mission_title": {
      "type": "string"
    },
    "repository_state": {
      "type": "object",
      "required": ["branch", "head", "dirty_state", "evidence_gaps_acknowledged"],
      "properties": {
        "branch": { "type": "string" },
        "head": { "type": "string" },
        "dirty_state": {
          "type": "object",
          "required": ["modified_count", "staged_count", "untracked_count", "untracked_files"],
          "properties": {
            "modified_count": { "type": "integer" },
            "staged_count": { "type": "integer" },
            "untracked_count": { "type": "integer" },
            "untracked_files": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evidence_gaps_acknowledged": {
          "type": "object",
          "required": ["missing_pre_edit_baseline", "prior_ruff_autofix_audit_gap"],
          "properties": {
            "missing_pre_edit_baseline": { "type": "boolean" },
            "prior_ruff_autofix_audit_gap": { "type": "boolean" }
          }
        }
      }
    },
    "steward_ownership": {
      "type": "object",
      "required": ["owned_python_files", "owned_typescript_files"],
      "properties": {
        "owned_python_files": { "type": "array", "items": { "type": "string" } },
        "owned_typescript_files": { "type": "array", "items": { "type": "string" } }
      }
    },
    "tool_adoption_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool_name",
          "python_module_class",
          "request_envelope_ref",
          "result_envelope_ref",
          "ready_to_expose",
          "opencode_wrapper_name",
          "is_mutating",
          "bypass_risk",
          "targeted_proof_required"
        ],
        "properties": {
          "tool_name": { "type": "string" },
          "python_module_class": { "type": "string" },
          "request_envelope_ref": { "type": "string" },
          "result_envelope_ref": { "type": "string" },
          "ready_to_expose": { "type": "boolean" },
          "opencode_wrapper_name": { "type": "string" },
          "is_mutating": { "type": "boolean" },
          "bypass_risk": { "type": "string" },
          "targeted_proof_required": { "type": "string" }
        }
      }
    },
    "external_harness_gateway": {
      "type": "object",
      "required": ["gateway_type", "python_cli_boundary", "actions"],
      "properties": {
        "gateway_type": { "type": "string", "const": "CLI_Gateway" },
        "python_cli_boundary": { "type": "string" },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action_name", "purpose", "cli_command_template"],
            "properties": {
              "action_name": { "type": "string" },
              "purpose": { "type": "string" },
              "cli_command_template": { "type": "string" }
            }
          }
        }
      }
    },
    "opencode_integration_stages": {
      "type": "object",
      "required": ["stage_a", "stage_b", "stage_c"],
      "properties": {
        "stage_a": {
          "type": "object",
          "required": ["description", "custom_tools_path", "wrappers"],
          "properties": {
            "description": { "type": "string" },
            "custom_tools_path": { "type": "string" },
            "wrappers": { "type": "array", "items": { "type": "string" } }
          }
        },
        "stage_b": {
          "type": "object",
          "required": ["description", "hook_name", "blocked_mutations", "apply_patch_handling"],
          "properties": {
            "description": { "type": "string" },
            "hook_name": { "type": "string" },
            "blocked_mutations": { "type": "array", "items": { "type": "string" } },
            "apply_patch_handling": { "type": "string" }
          }
        },
        "stage_c": {
          "type": "object",
          "required": ["description", "prerequisites", "risk"],
          "properties": {
            "description": { "type": "string" },
            "prerequisites": { "type": "array", "items": { "type": "string" } },
            "risk": { "type": "string" }
          }
        }
      }
    },
    "steward_observation_receipt_alignment": {
      "type": "object",
      "required": ["steward_observation_events", "rig_authoritative_receipts", "handoff_reference_strategy"],
      "properties": {
        "steward_observation_events": { "type": "array", "items": { "type": "string" } },
        "rig_authoritative_receipts": { "type": "array", "items": { "type": "string" } },
        "handoff_reference_strategy": { "type": "string" }
      }
    },
    "context_assembler_integration": {
      "type": "object",
      "required": ["request_flow", "context_envelope_contents", "confidentiality_guarantee"],
      "properties": {
        "request_flow": { "type": "string" },
        "context_envelope_contents": { "type": "array", "items": { "type": "string" } },
        "confidentiality_guarantee": { "type": "string" }
      }
    },
    "targeted_tests_and_classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test_name", "type", "description"],
        "properties": {
          "test_name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "dependencies_and_telemetry_implications": {
      "type": "object",
      "required": ["dependencies", "telemetry_events", "redaction_implications"],
      "properties": {
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "telemetry_events": { "type": "array", "items": { "type": "string" } },
        "redaction_implications": { "type": "string" }
      }
    },
    "current_vs_next_implementation_comparison": {
      "type": "object",
      "required": ["completed_steward_v0_work", "proposed_next_implementation_spine_v1"],
      "properties": {
        "completed_steward_v0_work": { "type": "array", "items": { "type": "string" } },
        "proposed_next_implementation_spine_v1": { "type": "array", "items": { "type": "string" } }
      }
    },
    "remaining_seams_and_deferrals": {
      "type": "object",
      "required": ["remaining_seams", "intentionally_deferred_work"],
      "properties": {
        "remaining_seams": { "type": "array", "items": { "type": "string" } },
        "intentionally_deferred_work": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
