{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/juliantorr-es/rig-relay/blob/main/docs/schemas/rig.static_site.render_candidate.v1.schema.json",
  "title": "Rig Static Site Render Candidate v1",
  "description": "Schema for compiler candidate configuration in the static site renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "candidate_id",
    "input_manifest_path",
    "output_dir",
    "safety_threshold"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "rig.static_site.render_candidate.v1"
    },
    "candidate_id": {
      "type": "string"
    },
    "input_manifest_path": {
      "type": "string"
    },
    "output_dir": {
      "type": "string"
    },
    "safety_threshold": {
      "type": "string",
      "enum": ["strict", "permissive"]
    }
  }
}
