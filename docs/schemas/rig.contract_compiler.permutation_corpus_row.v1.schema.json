{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rig.contract_compiler.permutation_corpus_row.v1",
  "title": "Contract Compiler Permutation Corpus Row v1",
  "description": "One row in the permutation corpus JSONL: aggregated statistics for a single candidate across its validation run.",
  "type": "object",
  "required": [
    "schema_version",
    "row_id",
    "run_id",
    "candidate_id",
    "contract_family_id",
    "contract_slice_id",
    "generator_id",
    "generator_version",
    "schema_pattern_id",
    "template_branch_id",
    "candidate_status",
    "fit_score",
    "gate_summary",
    "counterexample_count",
    "counterexample_cluster_ids",
    "promoted_to_stage",
    "accepted",
    "emitted_at",
    "content_light"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.contract_compiler.permutation_corpus_row.v1"
    },
    "row_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "contract_family_id": { "type": "string", "minLength": 1 },
    "contract_slice_id": { "type": "string", "minLength": 1 },
    "generator_id": { "type": "string", "minLength": 1 },
    "generator_version": { "type": "string", "minLength": 1 },
    "schema_pattern_id": {
      "type": "string",
      "description": "Which schema pattern this candidate used."
    },
    "template_branch_id": {
      "type": "string",
      "description": "Which Jinja2 template branch produced this candidate."
    },
    "candidate_status": {
      "type": "string",
      "enum": ["rejected", "quarantined", "partially_satisfied", "accepted"]
    },
    "fit_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "gate_summary": {
      "type": "object",
      "required": ["passed", "failed", "held", "skipped"],
      "properties": {
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "held": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "counterexample_count": { "type": "integer", "minimum": 0 },
    "counterexample_cluster_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "promoted_to_stage": { "type": "boolean" },
    "accepted": { "type": "boolean" },
    "emitted_at": { "type": "string", "format": "date-time" },
    "content_light": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
