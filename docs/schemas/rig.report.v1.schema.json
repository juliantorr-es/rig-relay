{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.report.v1.schema.json",
  "title": "Rig Report",
  "description": "Structured report envelope for rig.report tool. Agents use this to file mission reports, out-of-scope findings, bug reports, architecture seams, data races, and other structured discoveries. Reports are append-only to a local ledger; promotion to canonical findings is a separate triage step.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.report.v1"
    },
    "report_id": {
      "type": "string",
      "description": "Unique report identifier. Generated by the tool if not provided."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of report creation."
    },
    "created_by": {
      "type": "object",
      "properties": {
        "agent_id": { "type": "string" },
        "session_id": { "type": "string" },
        "lane_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "kind": {
      "type": "string",
      "enum": [
        "mission_report",
        "out_of_scope_finding",
        "bug_report",
        "architecture_seam",
        "implementation_seam",
        "data_race",
        "security_concern",
        "validation_gap",
        "test_gap",
        "tooling_gap",
        "context_gap",
        "coordination_gap",
        "regression_risk",
        "handoff_note"
      ],
      "description": "Kind of report. Determines which detail fields are relevant."
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high", "confirmed"]
    },
    "scope_relation": {
      "type": "string",
      "enum": ["in_scope", "out_of_scope_for_current_mission", "adjacent", "regression", "pre_existing"],
      "description": "How this report relates to the current mission scope."
    },
    "status": {
      "type": "string",
      "enum": [
        "open", "acknowledged", "triaged", "accepted", "deferred",
        "blocked", "in_progress", "resolved", "wont_fix",
        "superseded", "duplicate", "invalid"
      ],
      "default": "open"
    },
    "affected_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": { "type": "string" },
          "path": { "type": "string" },
          "summary": { "type": "string" }
        },
        "required": ["kind", "path", "summary"],
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_next_action": {
      "type": "string"
    },
    "dedupe_key": {
      "type": "string",
      "description": "Optional stable deduplication key. If not provided, derived from kind+title+affected_paths."
    },
    "links": {
      "type": "object",
      "properties": {
        "parent_report_id": { "type": "string" },
        "parent_mission_id": { "type": "string" },
        "related_report_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "details": {
      "type": "object",
      "description": "Kind-specific detail payload. Content and structure vary by kind. Not validated at the schema level."
    }
  },
  "required": [
    "schema_version", "report_id", "created_at",
    "kind", "title", "summary", "severity", "confidence",
    "scope_relation", "status"
  ],
  "additionalProperties": false
}
