{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json-schema.org/rig.local_inference.benchmark_summary.v1",
  "title": "Local Inference Benchmark Evidence Summary",
  "type": "object",
  "required": ["schema_version", "summary_id", "sample_count", "evidence_status"],
  "properties": {
    "schema_version": { "const": "rig.local_inference.benchmark_summary.v1" },
    "summary_id": { "type": "string" },
    "benchmark_source": { "type": "string" },
    "sample_count": { "type": "integer" },
    "runtime_url": { "type": "string" },
    "runtime_engine": { "type": "string" },
    "endpoint_sha256": { "type": "string" },
    "model_id_hash": { "type": "string" },
    "measurement_window_start": { "type": "string" },
    "measurement_window_end": { "type": "string" },
    "time_to_first_token_ms_p50": { "type": ["number", "null"] },
    "time_to_first_token_ms_p95": { "type": ["number", "null"] },
    "tokens_per_sec_decode_p50": { "type": ["number", "null"] },
    "tokens_per_sec_decode_p95": { "type": ["number", "null"] },
    "prompt_ingestion_tokens_per_sec_p50": { "type": ["number", "null"] },
    "end_to_end_latency_ms_p50": { "type": ["number", "null"] },
    "end_to_end_latency_ms_p95": { "type": ["number", "null"] },
    "error_count_total": { "type": "integer" },
    "error_count_by_class": { "type": "object" },
    "cancellation_samples": { "type": "integer" },
    "concurrency_level": { "type": "integer" },
    "context_size_buckets": { "type": "object" },
    "evidence_status": { "type": "string", "enum": ["available", "missing", "stale", "error"] },
    "stale": { "type": "boolean" },
    "redaction_summary": { "type": "string" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
