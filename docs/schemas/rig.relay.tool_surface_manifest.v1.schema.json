{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.tool_surface_manifest.v1.schema.json",
  "title": "Tool Surface Manifest v1",
  "description": "Canonical content-light manifest of admitted tools for deterministic recovery. Generated from the real ToolManager.available_tools surface.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "generated_at",
    "admitted_tools",
    "manifest_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "rig.relay.tool_surface_manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "description": "Unique identifier for this manifest instance"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "admitted_tools": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/admitted_tool_entry"
      }
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "admitted_tool_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_name",
        "mutation_class",
        "determinism_class",
        "args_schema_digest",
        "recovery_admission_tier"
      ],
      "properties": {
        "canonical_name": {
          "type": "string"
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "mutation_class": {
          "type": "string"
        },
        "determinism_class": {
          "type": "string"
        },
        "args_schema_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "arg_field_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recovery_admission_tier": {
          "enum": [
            "read_only_recoverable",
            "validation_recoverable",
            "mutation_proposal_only",
            "external_side_effect_refuse",
            "raw_shell_refuse",
            "unsupported_refuse"
          ]
        }
      }
    }
  }
}
