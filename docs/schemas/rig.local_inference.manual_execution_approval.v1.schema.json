{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json-schema.org/rig.local_inference.manual_execution_approval.v1",
  "title": "Manual Execution Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_id", "generated_at", "expires_at", "approved_by", "scope_max_prompt_bytes", "scope_max_output_tokens", "approval_hash"],
  "properties": {
    "schema_version": {"const": "rig.local_inference.manual_execution_approval.v1"},
    "approval_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "ttl_seconds": {"type": "integer", "minimum": 0},
    "approved_by": {"type": "string", "enum": ["human", "fixture", "policy"]},
    "approved_for_profile": {"type": "string"},
    "scope_endpoint_hash": {"type": "string"},
    "scope_task_profile": {"type": "string"},
    "scope_request_class": {"type": "string", "enum": ["chat", "completion", "embedding", "tool_use", "structured_output", "vision"]},
    "scope_max_prompt_bytes": {"type": "integer", "minimum": 0},
    "scope_max_output_tokens": {"type": "integer", "minimum": 0},
    "scope_streaming_allowed": {"type": "boolean"},
    "scope_tool_calling_allowed": {"type": "boolean"},
    "scope_structured_output_allowed": {"type": "boolean"},
    "persistence_policy": {"type": "string", "enum": ["metadata_only", "hash_only", "ephemeral_debug_disabled", "debug_packet_requires_separate_gate"]},
    "approval_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "redaction_summary": {"type": "string"}
  }
}
