{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.runtime_context.v1.schema.json",
  "title": "Rig Relay Runtime Context v1",
  "description": "Content-light runtime context resolver output that derives canonical session/task/worktree coordination context without raw logs or outputs.",
  "oneOf": [
    {
      "$ref": "#/definitions/RuntimeContext"
    },
    {
      "$ref": "#/definitions/RuntimeContextResolution"
    }
  ],
  "definitions": {
    "RuntimeContext": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "enum": ["rig.relay.runtime_context.v1"] },
        "session_id": { "type": "string" },
        "task_id": { "type": "string" },
        "lane_id": { "type": ["string", "null"] },
        "workspace_id": { "type": ["string", "null"] },
        "worktree_path": { "type": ["string", "null"] },
        "repo_root": { "type": ["string", "null"] },
        "coordination_scope": { "type": ["string", "null"] },
        "receipt_index_path": { "type": ["string", "null"] },
        "dirty_policy": { "type": ["string", "null"] },
        "resolved_from": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["schema_version", "session_id", "task_id", "resolved_from", "warnings"],
      "additionalProperties": false
    },
    "RuntimeContextResolution": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "string", "enum": ["rig.relay.runtime_context_resolution.v1"] },
        "status": { "type": "string", "enum": ["resolved", "blocked", "refused"] },
        "context": {
          "anyOf": [
            { "$ref": "#/definitions/RuntimeContext" },
            { "type": "null" }
          ]
        },
        "error_kind": { "type": ["string", "null"] },
        "refusal_reason": { "type": ["string", "null"] }
      },
      "required": ["schema_version", "status"],
      "additionalProperties": false
    }
  }
}
