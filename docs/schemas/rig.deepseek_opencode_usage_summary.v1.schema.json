{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.deepseek_opencode_usage_summary.v1.schema.json",
  "title": "DeepSeek OpenCode Usage Summary Schema",
  "description": "Lightweight local-only summary of DeepSeek OpenCode usage, cache economics, lane split, and cache-write visibility for dashboard and static-site use. This summary is derived from the canonical usage report without copying prompts, completions, secrets, or raw private paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "source_report_path",
    "source_report_sha256",
    "opencode_version",
    "provider",
    "session_count",
    "request_count_if_available",
    "lane_usage",
    "cache_hit_ratio",
    "cache_read_token_total",
    "cache_write_visibility",
    "cache_write_visibility_note",
    "estimated_discounted_cost_usd",
    "estimated_full_cost_usd",
    "recommended_lane",
    "lane_policy_summary",
    "final_recommendation_summary",
    "redaction_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "rig.deepseek_opencode_usage_summary.v1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_report_path": {
      "type": "string",
      "minLength": 1
    },
    "source_report_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "opencode_version": {
      "type": "string"
    },
    "provider": {
      "type": "string",
      "const": "deepseek"
    },
    "session_count": {
      "type": "integer",
      "minimum": 0
    },
    "request_count_if_available": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "lane_usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/lane_usage_row"
      }
    },
    "cache_hit_ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "cache_read_token_total": {
      "type": "integer",
      "minimum": 0
    },
    "cache_write_visibility": {
      "type": "string",
      "enum": [
        "reported_zero",
        "reported_nonzero",
        "not_reported_by_source",
        "unknown"
      ]
    },
    "cache_write_visibility_note": {
      "type": "string",
      "minLength": 1
    },
    "estimated_discounted_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "estimated_full_cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "recommended_lane": {
      "type": "string",
      "minLength": 1
    },
    "lane_policy_summary": {
      "type": "string",
      "minLength": 1
    },
    "final_recommendation_summary": {
      "type": "string",
      "minLength": 1
    },
    "redaction_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "lane_usage_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "variant",
        "session_count",
        "request_count",
        "session_share",
        "request_share"
      ],
      "properties": {
        "model_id": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "session_count": {
          "type": "integer",
          "minimum": 0
        },
        "request_count": {
          "type": "integer",
          "minimum": 0
        },
        "session_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "request_share": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
