{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.github.maintenance_report.v1.schema.json",
  "title": "GitHub Maintenance Report v1",
  "description": "Report summarizing GitHub maintenance task execution counts. Content-light; never exposes raw tokens, secrets, or vulnerable code.",
  "type": "object",
  "required": [
    "schema_version",
    "tasks_run",
    "tasks_refreshed"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.github.maintenance_report.v1" },
    "tasks_run": { "type": "integer" },
    "tasks_refreshed": { "type": "integer" }
  },
  "additionalProperties": true
}
