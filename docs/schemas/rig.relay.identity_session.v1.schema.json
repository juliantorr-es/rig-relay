{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.identity_session.v1.schema.json",
  "title": "Identity Session Status",
  "description": "Aggregate identity session status across all providers. Content-light summary — no raw tokens.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version identifier."
    },
    "providers": {
      "type": "object",
      "description": "Per-provider status keyed by provider name.",
      "additionalProperties": {
        "$ref": "rig.relay.identity_provider.v1.schema.json"
      },
      "minProperties": 1
    },
    "any_signed_in": {
      "type": "boolean",
      "description": "True if at least one provider has signed_in status."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this status was generated."
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Aggregate warnings."
    }
  },
  "required": ["schema_version", "providers", "any_signed_in", "generated_at"],
  "additionalProperties": false
}
