{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.test_classification.v1.schema.json",
  "title": "Rig Relay Test Classification v1",
  "description": "Per-test classification entry recording the audit bucket (keep/harden/replace/delete), reason, test kind tags, and the production seam it protects. Append-only JSONL ledger.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["rig.relay.test_classification.v1"]
    },
    "file_path": {
      "type": "string",
      "description": "Relative path to the test file from repo root"
    },
    "test_function": {
      "type": "string",
      "description": "Test function name"
    },
    "classification": {
      "type": "string",
      "enum": ["keep", "harden", "replace", "delete"],
      "description": "Audit bucket"
    },
    "reason": {
      "type": "string",
      "description": "One-sentence reason for the classification"
    },
    "test_kind": {
      "type": "string",
      "enum": ["unit", "contract", "integration", "E2E", "real-artifact", "adversarial", "sabotage", "concurrency", "substrate"],
      "description": "Test kind tag"
    },
    "protected_seam": {
      "type": "string",
      "description": "The real production seam this test protects"
    },
    "stress_surface": {
      "type": "string",
      "enum": ["coordination", "git-discipline", "tool-invocation", "runtime-supervisor", "telemetry-redaction", "static-renderer", "release-gate", "other"],
      "description": "Priority stress surface this test belongs to"
    },
    "classification_timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of classification"
    }
  },
  "required": ["schema_version", "file_path", "test_function", "classification", "reason", "test_kind", "protected_seam", "classification_timestamp"]
}
