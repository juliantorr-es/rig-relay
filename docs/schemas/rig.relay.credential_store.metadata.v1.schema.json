{"$schema":"http://json-schema.org/draft-07/schema#","$id":"https://rig-relay.github.io/schemas/rig.relay.credential_store.metadata.v1.schema.json","title":"Credential Store Metadata v1","description":"Content-light credential store metadata — contains only SHA-256 hashes, never raw credentials.","type":"object","required":["schema_version","entries"],"properties":{"schema_version":{"type":"string","const":"rig.relay.credential_store.metadata.v1"},"entries":{"type":"array","items":{"type":"object","required":["provider","credential_kind","stored_at","credential_hash","status"],"properties":{"provider":{"type":"string"},"credential_kind":{"type":"string"},"stored_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"credential_hash":{"type":"string","description":"SHA-256 of the raw credential. Never the raw credential value."},"status":{"type":"string","enum":["active","expired","revoked","unknown"]}},"additionalProperties":false,"not":{"anyOf":[{"required":["access_token"]},{"required":["refresh_token"]},{"required":["credential"]},{"required":["token"]},{"required":["secret"]},{"required":["password"]},{"required":["api_key"]}]}}}},"additionalProperties":false}
