{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.distribution.release_research.v1.schema.json",
  "title": "Distribution Release Research v1",
  "type": "object",
  "required": ["schema_version", "generated_at", "content_light", "remote_mutation", "live_network_used_for_product", "summary"],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.distribution.release_research.v1" },
    "generated_at": { "type": "string" }, "branch": { "type": ["string", "null"] }, "head": { "type": ["string", "null"] },
    "dirty_files_count": { "type": "integer" },
    "content_light": { "type": "boolean", "const": true },
    "remote_mutation": { "type": "boolean", "const": false },
    "live_network_used_for_product": { "type": "boolean", "const": false },
    "summary": { "type": "object", "required": ["channel_count", "credential_count", "api_count", "validation_count", "mutation_lane_count", "risk_count", "phase_count"] },
    "metadata_matrix": { "type": "array", "items": { "type": "object" } },
    "artifact_concepts": { "type": "array", "items": { "type": "object" } }
  },
  "additionalProperties": true
}
