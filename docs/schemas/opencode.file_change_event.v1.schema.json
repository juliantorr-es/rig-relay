{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/opencode.file_change_event.v1.schema.json",
  "title": "OpenCode File Change Event v1",
  "description": "Append-only JSONL change event for a file mutation captured by a custom OpenCode file tool.",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "created_at",
    "target_path",
    "operation",
    "summary",
    "reason",
    "before_sha256",
    "after_sha256",
    "before_line_count",
    "after_line_count",
    "before_byte_count",
    "after_byte_count",
    "search_text",
    "replace_text",
    "replace_all",
    "context_artifact_path",
    "context_artifact_id",
    "content_light"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "opencode.file_change_event.v1" },
    "event_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "target_path": { "type": "string" },
    "operation": { "type": "string" },
    "summary": { "type": "string" },
    "reason": { "type": "string" },
    "before_sha256": { "type": "string" },
    "after_sha256": { "type": "string" },
    "before_line_count": { "type": "integer", "minimum": 0 },
    "after_line_count": { "type": "integer", "minimum": 0 },
    "before_byte_count": { "type": "integer", "minimum": 0 },
    "after_byte_count": { "type": "integer", "minimum": 0 },
    "search_text": { "type": ["string", "null"] },
    "replace_text": { "type": ["string", "null"] },
    "replace_all": { "type": "boolean" },
    "context_artifact_path": { "type": ["string", "null"] },
    "context_artifact_id": { "type": ["string", "null"] },
    "content_light": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
