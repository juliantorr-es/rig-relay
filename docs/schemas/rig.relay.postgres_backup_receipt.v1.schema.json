{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.postgres_backup_receipt.v1.schema.json",
  "title": "PostgreSQL Backup Receipt",
  "description": "Content-light receipt for a PostgreSQL backup operation. Records what was backed up, how secrets were excluded, and the backup artifact identity. This record is content-light: it contains only digests, counts, and metadata. No raw connection strings, passwords, or backup file contents are stored. The backup_sha256 identifies the backup artifact but the artifact itself is never embedded.",
  "type": "object",
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "Unique receipt identifier."
    },
    "backup_method": {
      "type": "string",
      "default": "pg_dump",
      "description": "Backup method used."
    },
    "database_name": {
      "type": "string",
      "default": "",
      "description": "Database name (content-light)."
    },
    "schema_name": {
      "type": "string",
      "default": "",
      "description": "Schema name backed up."
    },
    "format": {
      "type": "string",
      "enum": ["custom", "plain", "tar", "directory"],
      "default": "custom",
      "description": "Backup format (custom, plain, tar, directory)."
    },
    "backup_sha256": {
      "type": "string",
      "default": "",
      "description": "SHA256 digest of the backup artifact."
    },
    "backup_size_bytes": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Backup artifact size in bytes."
    },
    "table_count": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Number of tables in backup."
    },
    "migration_version": {
      "type": "integer",
      "minimum": 0,
      "default": 0,
      "description": "Schema version at backup time."
    },
    "secrets_excluded": {
      "type": "boolean",
      "default": true,
      "description": "Whether secrets were excluded."
    },
    "exclusion_method": {
      "type": "string",
      "default": "",
      "description": "How secrets were excluded (e.g. --exclude-table-data)."
    },
    "backed_up_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp of backup."
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether backup was verified after creation."
    }
  },
  "required": ["receipt_id"],
  "additionalProperties": false
}
