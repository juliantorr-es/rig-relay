{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.github.live_mutation_phase3_projection.v1.schema.json",
  "title": "Live Mutation Phase 3 Projection v1",
  "description": "Projection summarizing the state of the Phase 3 live mutation readiness gates. Content-light; never exposes raw tokens, secrets, or vulnerable code.",
  "type": "object",
  "required": [
    "schema_version",
    "available",
    "phase_status",
    "live_mutation_status",
    "preflight_status",
    "transaction_status",
    "chaos_invariant_status",
    "approval_status",
    "branch_status",
    "pr_status",
    "alert_update_status",
    "rollback_guidance_status",
    "next_safe_action",
    "blocked_reasons",
    "required_human_action",
    "raw_payloads_exposed"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.github.live_mutation_phase3_projection.v1" },
    "available": { "type": "boolean" },
    "phase_status": { "type": "string" },
    "live_mutation_status": { "type": "string" },
    "preflight_status": { "type": "string" },
    "transaction_status": { "type": "string" },
    "chaos_invariant_status": { "type": "string" },
    "approval_status": { "type": "string" },
    "branch_status": { "type": "string" },
    "pr_status": { "type": "string" },
    "alert_update_status": { "type": "string" },
    "rollback_guidance_status": { "type": "string" },
    "next_safe_action": { "type": "string" },
    "blocked_reasons": { "type": "array", "items": { "type": "string" } },
    "required_human_action": { "type": "string" },
    "raw_payloads_exposed": { "type": "boolean" }
  },
  "additionalProperties": true
}
