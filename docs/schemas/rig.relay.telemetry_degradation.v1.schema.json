{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/juliantorr-es/rig-relay/blob/main/docs/schemas/rig.relay.telemetry_degradation.v1.schema.json",
  "title": "Telemetry Degradation Marker",
  "description": "Written when telemetry is disabled by user opt-out. Records preserved and degraded capabilities. Correlation fields were added additively in correlation spine v1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "degradation_mode", "degradation_reason", "generated_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.relay.telemetry_degradation.v1" },
    "session_id": { "type": "string", "minLength": 1 },
    "degradation_mode": { "type": "string" },
    "degradation_reason": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "runtime_correlation_preserved": { "type": "boolean" },
    "persisted_observability_correlation_disabled": { "type": "boolean" },
    "cross_session_trace_reconstruction_degraded": { "type": "boolean" },
    "telemetry_reason": { "type": "string" },
    "preserved_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "degraded_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "disabled_capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "export_allowed": { "type": "boolean" },
    "debug_quarantine_enabled": { "type": "boolean" }
  }
}
