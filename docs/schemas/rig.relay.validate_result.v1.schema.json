{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.validate_result.v1.schema.json",
  "title": "Rig Relay Validate Result v1",
  "description": "Structured validation result with per-check results, blocker taxonomy, and aggregate counts. Content-light: no raw stdout/stderr bodies in the result envelope.",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "blocked",
        "failed",
        "passed",
        "refused",
        "skipped",
        "timed_out",
        "unknown"
      ],
      "description": "Overall validation status"
    },
    "profile": {
      "type": "string",
      "description": "Echoed input profile name"
    },
    "scope": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Echoed input scope"
    },
    "command_count": {
      "type": "integer",
      "description": "Total commands run"
    },
    "passed_count": {
      "type": "integer",
      "description": "Count of passing checks"
    },
    "failed_count": {
      "type": "integer",
      "description": "Count of failing checks"
    },
    "skipped_count": {
      "type": "integer",
      "description": "Count of skipped checks"
    },
    "duration_ms": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Total elapsed time in milliseconds"
    },
    "suggested_next_action": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Operator-facing next action for a refusal or failure"
    },
    "retryable": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "description": "Whether the validation request is retryable"
    },
    "checks": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ValidateCheckResult"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Per-check results"
    },
    "blocker_summary": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Blocker counts by kind"
    },
    "changed_files": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ],
      "description": "Files changed during validation (only when profile allows mutation)"
    },
    "before_git_state": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/ValidateGitState"
        }
      ],
      "description": "Optional pre-state git workspace snapshot"
    },
    "after_git_state": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/ValidateGitState"
        }
      ],
      "description": "Optional post-state git workspace snapshot"
    },
    "error_kind": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Final error category"
    },
    "refusal_reason": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Human-readable refusal summary"
    }
  },
  "required": [
    "status",
    "profile",
    "command_count",
    "passed_count",
    "failed_count",
    "skipped_count"
  ],
  "additionalProperties": false,
  "definitions": {
    "ValidateCheckResult": {
      "type": "object",
      "properties": {
        "check_id": {
          "type": "string",
          "description": "Stable check identifier"
        },
        "command_kind": {
          "type": "string",
          "description": "Kind of check (pytest, ruff, pyright, git, schema, policy, custom)"
        },
        "command_display": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Human-readable command summary"
        },
        "command_fingerprint": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Hash of normalized command"
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "skipped",
            "blocked",
            "timed_out",
            "refused"
          ]
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Process exit code when present"
        },
        "duration_ms": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Measured runtime in milliseconds"
        },
        "stdout_sha256": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA256 hash of raw stdout"
        },
        "stderr_sha256": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA256 hash of raw stderr"
        },
        "stdout_bytes": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Byte count of raw stdout"
        },
        "stderr_bytes": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Byte count of raw stderr"
        },
        "stdout_truncated": {
          "type": "boolean",
          "description": "Whether stdout exceeded cap"
        },
        "stderr_truncated": {
          "type": "boolean",
          "description": "Whether stderr exceeded cap"
        },
        "parsed_summary": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional structured summary from a profile-specific parser"
        },
        "failure_kind": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Blocker kind when status is not passed"
        },
        "affected_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Optional hash-safe path list"
        },
        "cache_status": {
          "type": "string",
          "enum": [
            "disabled",
            "hit",
            "miss_ran",
            "miss_changed_inputs",
            "miss_missing_record",
            "miss_failed_reuse_disabled",
            "miss_force_rerun",
            "blocked_running",
            "error"
          ],
          "description": "Cache status for this check result."
        },
        "cache_key": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cache key used for this check."
        },
        "cache_record_sha256": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "SHA256 of the cache record for this result."
        },
        "input_fingerprint": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Composite input fingerprint for cache invalidation."
        },
        "reused_from": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cache key of the reused record if this is a cache hit."
        },
        "scheduler_status": {
          "type": "string",
          "enum": [
            "not_scheduled",
            "queued",
            "coalesced",
            "running",
            "completed",
            "blocked_duplicate",
            "policy_refused"
          ],
          "description": "Scheduler status for this check."
        },
        "parallel_status": {
          "type": "string",
          "enum": [
            "disabled",
            "enabled",
            "not_applicable",
            "refused"
          ],
          "description": "Parallel execution status for this check."
        },
        "worker_count": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Number of parallel workers used."
        },
        "distribution": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "pytest-xdist distribution mode."
        },
        "validation_phase": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Validation phase when this check was run."
        }
      },
      "required": [
        "check_id",
        "command_kind",
        "status"
      ],
      "additionalProperties": false
    },
    "ValidateGitState": {
      "type": "object",
      "description": "Content-light git workspace state snapshot. Contains no file contents, diffs, or raw git status output.",
      "properties": {
        "branch": {
          "type": "string",
          "description": "Current git branch"
        },
        "head": {
          "type": "string",
          "description": "Full SHA of HEAD"
        },
        "is_git_repo": {
          "type": "boolean",
          "description": "Whether cwd is inside a git worktree"
        },
        "is_worktree": {
          "type": "boolean",
          "description": "Whether HEAD is detached (branch is None)"
        },
        "upstream": {
          "type": "string",
          "description": "Upstream tracking branch"
        },
        "ahead_count": {
          "type": "integer",
          "description": "Commits ahead of upstream"
        },
        "behind_count": {
          "type": "integer",
          "description": "Commits behind upstream"
        },
        "dirty_count": {
          "type": "integer",
          "description": "Total dirtied paths"
        },
        "modified_count": {
          "type": "integer",
          "description": "Working tree modifications"
        },
        "deleted_count": {
          "type": "integer",
          "description": "Working tree deletions"
        },
        "untracked_count": {
          "type": "integer",
          "description": "Untracked files"
        },
        "staged_count": {
          "type": "integer",
          "description": "Staged changes"
        },
        "conflicted_count": {
          "type": "integer",
          "description": "Conflicted files"
        },
        "dirty_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative POSIX paths of dirty files"
        },
        "untracked_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative POSIX paths of untracked files"
        },
        "changed_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Workspace-relative POSIX paths of all changed files"
        },
        "status_porcelain_sha256": {
          "type": "string",
          "description": "SHA256 hash of raw git status output"
        },
        "error_kind": {
          "type": "string",
          "description": "Error category if git state collection failed"
        },
        "refusal_reason": {
          "type": "string",
          "description": "Human-readable failure reason"
        }
      },
      "additionalProperties": false
    }
  }
}
