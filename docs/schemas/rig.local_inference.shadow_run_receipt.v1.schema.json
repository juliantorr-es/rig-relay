{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://json-schema.org/rig.local_inference.shadow_run_receipt.v1",
  "title": "Shadow Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "shadow_run_id", "scenario_id", "generated_at", "status", "raw_prompt_persisted", "raw_completion_persisted", "automatic_agent_execution", "agent_state_mutated", "tool_execution_allowed", "file_mutation_allowed"],
  "properties": {
    "schema_version": {"const": "rig.local_inference.shadow_run_receipt.v1"},
    "shadow_run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"type": "string"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["blocked", "executed", "failed", "contract_passed", "contract_failed", "reference_missing", "comparison_unavailable"]},
    "task_profile": {"type": "string"},
    "request_class": {"type": "string"},
    "endpoint_hash": {"type": "string"},
    "model_safe_id": {"type": "string"},
    "approval_id": {"type": "string"},
    "selection_policy_status": {"type": "string"},
    "manual_execution_receipt_ref": {"type": "string"},
    "prompt_sha256": {"type": "string"},
    "prompt_byte_count": {"type": "integer"},
    "completion_sha256": {"type": "string"},
    "completion_byte_count": {"type": "integer"},
    "latency_ms": {"type": "integer"},
    "output_token_count": {"type": "integer"},
    "input_token_count": {"type": "integer"},
    "output_contract": {"type": "string"},
    "contract_result": {"type": "string"},
    "contract_failure_codes": {"type": "array", "items": {"type": "string"}},
    "comparison_result": {"type": "string"},
    "fallback_required": {"type": "boolean"},
    "blocked_reasons": {"type": "array", "items": {"type": "string"}},
    "redaction_summary": {"type": "string"},
    "raw_prompt_persisted": {"const": false},
    "raw_completion_persisted": {"const": false},
    "automatic_agent_execution": {"const": false},
    "agent_state_mutated": {"const": false},
    "tool_execution_allowed": {"const": false},
    "file_mutation_allowed": {"const": false},
    "provider_fallback_execution_allowed": {"type": "boolean"},
    "shadow_output_promotable_to_user": {"type": "boolean"},
    "shadow_output_promotable_to_training": {"type": "boolean"}
  }
}
