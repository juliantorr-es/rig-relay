{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.vibe.dev/schemas/rig.relay.artifact.task_session_link.v1.schema.json",
  "title": "Task Session Link Artifact",
  "type": "object",
  "required": [
    "artifact_kind",
    "status",
    "linkage_sha256"
  ],
  "properties": {
    "artifact_kind": {
      "type": "string",
      "const": "task_session_link"
    },
    "parent_session_id": {
      "type": ["string", "null"]
    },
    "parent_turn_id": {
      "type": ["string", "null"]
    },
    "parent_tool_call_id": {
      "type": ["string", "null"]
    },
    "task_id": {
      "type": ["string", "null"]
    },
    "child_session_id": {
      "type": ["string", "null"]
    },
    "provider": {
      "type": ["string", "null"]
    },
    "model": {
      "type": ["string", "null"]
    },
    "thinking_requested": {
      "type": "boolean"
    },
    "thinking_enabled": {
      "type": ["boolean", "null"]
    },
    "thinking_type": {
      "type": ["string", "null"]
    },
    "reasoning_effort": {
      "type": ["string", "null"]
    },
    "tool_access_policy": {
      "type": ["string", "null"]
    },
    "result_compression_policy": {
      "type": ["string", "null"]
    },
    "timeout_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "input_prompt_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "output_result_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "child_artifact_manifest_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "linkage_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "refused", "failed", "truncated"]
    },
    "started_at": {
      "type": ["string", "null"]
    },
    "completed_at": {
      "type": ["string", "null"]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
