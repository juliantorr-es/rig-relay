{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.relay.stale_markdown_evidence_purge.v1.schema.json",
  "title": "Stale Markdown Evidence Purge v1",
  "description": "Structured evidence of a stale Markdown evidence purge operation.",
  "type": "object",
  "required": ["schema_version", "purge_id", "title", "generated_at", "summary", "content_light"],
  "properties": {
    "schema_version": { "type": "string", "const": "rig.relay.stale_markdown_evidence_purge.v1" },
    "purge_id": { "type": "string" },
    "title": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "branch": { "type": "string" },
    "head_commit": { "type": "string" },
    "summary": { "type": "object" },
    "doctrine_applied": { "type": "object" },
    "categories": { "type": "object" },
    "content_light": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
