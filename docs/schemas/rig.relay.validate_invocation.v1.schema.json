{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.dev/schemas/rig.relay.validate_invocation.v1.schema.json",
  "title": "Rig Relay Validate Invocation v1",
  "description": "Invocation arguments for a validate profile run. Describes which profile, scope, paths, and policy constraints to apply.",
  "type": "object",
  "properties": {
    "profile": {
      "type": "string",
      "description": "Named validation profile (quick, python, schemas, receipt-policy, tool-hardening)"
    },
    "scope": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional mission scope label"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional path scope for targeted validation"
    },
    "workspace_root": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Working root for deterministic resolution"
    },
    "timeout_seconds": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ],
      "description": "Per-profile timeout override in seconds"
    },
    "check_only": {
      "type": "boolean",
      "description": "If true, only check without mutation (default: true)"
    },
    "allow_network": {
      "type": "boolean",
      "description": "If true, allow network-requiring checks (default: false)"
    },
    "allow_mutation": {
      "type": "boolean",
      "description": "If true, allow mutation-capable checks (default: false)"
    },
    "env_profile": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Restricted environment profile"
    },
    "expected_dirty_policy": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Expected workspace dirty policy (clean, allow_dirty, allow_listed_dirty)"
    },
    "output_cap_bytes": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Output cap per-check before truncation"
    }
  },
  "required": [
    "profile"
  ],
  "additionalProperties": false
}
