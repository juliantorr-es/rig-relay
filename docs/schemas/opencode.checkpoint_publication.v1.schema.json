{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/opencode.checkpoint_publication.v1.schema.json",
  "title": "OpenCode Checkpoint Publication v1",
  "description": "Canonical artifact emitted when an admitted checkpoint is pushed exactly once.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "created_at",
    "publisher_name",
    "remote_name",
    "target_ref",
    "plan_id",
    "plan_revision",
    "checkpoint_commit_receipt_sha256",
    "checkpoint_commit_artifact_path",
    "checkpoint_commit_sha",
    "checkpoint_sequence",
    "parent_checkpoint_receipt_sha256",
    "candidate_packet_digest",
    "review_artifact_path",
    "review_artifact_sha256",
    "admitted_review_status",
    "pre_push_head",
    "post_push_head",
    "pushed_commit_sha",
    "remote_verified",
    "publication_notes",
    "files_published",
    "post_push_checks",
    "content_light"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "opencode.checkpoint_publication.v1" },
    "artifact_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "publisher_name": { "type": "string" },
    "remote_name": { "type": "string" },
    "target_ref": { "type": "string" },
    "plan_id": { "type": "string" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "checkpoint_commit_receipt_sha256": { "type": "string" },
    "checkpoint_commit_artifact_path": { "type": "string" },
    "checkpoint_commit_sha": { "type": "string" },
    "checkpoint_sequence": { "type": "integer", "minimum": 1 },
    "parent_checkpoint_receipt_sha256": { "type": ["string", "null"] },
    "candidate_packet_digest": { "type": "string" },
    "review_artifact_path": { "type": "string" },
    "review_artifact_sha256": { "type": "string" },
    "admitted_review_status": { "type": "string", "enum": ["prepublication_admitted"] },
    "pre_push_head": { "type": "string" },
    "post_push_head": { "type": "string" },
    "pushed_commit_sha": { "type": "string" },
    "remote_verified": { "type": "boolean" },
    "publication_notes": { "type": "array", "items": { "type": "string" } },
    "files_published": { "type": "array", "items": { "type": "string" } },
    "post_push_checks": { "type": "array", "items": { "type": "string" } },
    "content_light": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
