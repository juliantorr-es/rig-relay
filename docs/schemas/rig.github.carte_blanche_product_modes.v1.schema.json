{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/rig.github.carte_blanche_product_modes.v1.schema.json",
  "title": "GitHub Carte Blanche Product Modes v1",
  "description": "Full product modes a developer could enable under maximum trust.",
  "type": "object",
  "required": ["schema_version", "generated_at", "content_light", "remote_mutation", "total_modes", "modes", "user_journeys", "summary"],
  "properties": {
    "schema_version": {"type": "string", "const": "rig.github.carte_blanche_product_modes.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "content_light": {"type": "boolean", "const": true},
    "remote_mutation": {"type": "boolean", "const": false},
    "total_modes": {"type": "integer", "minimum": 0},
    "total_journeys": {"type": "integer", "minimum": 0},
    "modes": {"type": "array", "items": {"$ref": "#/definitions/mode_entry"}},
    "user_journeys": {"type": "array", "items": {"$ref": "#/definitions/journey_entry"}},
    "summary": {"type": "object", "required": ["modes_count", "journeys_count", "next_slice"], "properties": {
      "modes_count": {"type": "integer"}, "journeys_count": {"type": "integer"}, "next_slice": {"type": "string"}
    }, "additionalProperties": false}
  },
  "additionalProperties": true,
  "definitions": {
    "mode_entry": {
      "type": "object",
      "required": ["mode_id", "target_user", "value_summary", "required_permissions", "first_implementation_slice"],
      "properties": {
        "mode_id": {"type": "string"}, "target_user": {"type": "string"},
        "default_enabled": {"type": "boolean"}, "value_summary": {"type": "string"},
        "daily_loop": {"type": "string"}, "required_permissions": {"type": "array", "items": {"type": "string"}},
        "required_webhooks": {"type": "array", "items": {"type": "string"}},
        "approval_policy": {"type": "string"}, "evidence_policy": {"type": "string"},
        "failure_modes": {"type": "array", "items": {"type": "string"}},
        "first_implementation_slice": {"type": "string"}, "remaining_seams": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "journey_entry": {
      "type": "object",
      "required": ["journey_id", "starting_state", "user_goal", "first_mvp_version"],
      "properties": {
        "journey_id": {"type": "string"}, "starting_state": {"type": "string"},
        "user_goal": {"type": "string"}, "permissions_used": {"type": "array", "items": {"type": "string"}},
        "read_steps": {"type": "array", "items": {"type": "string"}},
        "mutation_steps": {"type": "array", "items": {"type": "string"}},
        "approval_gates": {"type": "array", "items": {"type": "string"}},
        "success_metrics": {"type": "array", "items": {"type": "string"}},
        "failure_modes": {"type": "array", "items": {"type": "string"}},
        "first_mvp_version": {"type": "string"}, "mature_version": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
