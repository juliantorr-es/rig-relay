{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rig-relay.github.io/schemas/opencode.session_report.v1.schema.json",
  "title": "OpenCode Session Report v1",
  "description": "Canonical report artifact that synthesizes the plan, wave artifacts, and critic comments into a coherent session summary.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "created_at",
    "plan_id",
    "plan_revision",
    "plan_digest",
    "plan_path",
    "comment_ledger_path",
    "execution_artifacts",
    "validation_artifacts",
    "stress_artifacts",
    "checkpoint_preparations",
    "checkpoint_commits",
    "publication_artifacts",
    "plan_comment_count",
    "plan_comment_summaries",
    "report_summary",
    "next_steps",
    "blocked_seams",
    "content_light"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "opencode.session_report.v1" },
    "artifact_id": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "plan_id": { "type": "string" },
    "plan_revision": { "type": "integer", "minimum": 1 },
    "plan_digest": { "type": "string" },
    "plan_path": { "type": "string" },
    "comment_ledger_path": { "type": "string" },
    "execution_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "digest"],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "validation_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "digest"],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "stress_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "digest"],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "checkpoint_preparations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "digest"],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "checkpoint_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "digest"],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "publication_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "path", "digest"],
        "properties": {
          "artifact_id": { "type": "string" },
          "path": { "type": "string" },
          "digest": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "plan_comment_count": { "type": "integer", "minimum": 0 },
    "plan_comment_summaries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "comment_id",
          "critic_name",
          "severity",
          "category",
          "wave_id",
          "comment",
          "suggested_change",
          "references"
        ],
        "properties": {
          "comment_id": { "type": "string" },
          "critic_name": { "type": "string" },
          "severity": { "type": "string" },
          "category": { "type": "string" },
          "wave_id": { "type": ["string", "null"] },
          "comment": { "type": "string" },
          "suggested_change": { "type": "string" },
          "references": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "report_summary": { "type": "string" },
    "next_steps": { "type": "array", "items": { "type": "string" } },
    "blocked_seams": { "type": "array", "items": { "type": "string" } },
    "content_light": { "type": "boolean", "const": true }
  },
  "additionalProperties": false
}
