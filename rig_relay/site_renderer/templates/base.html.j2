<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} — Rig Relay</title>
<meta name="description" content="{{ description | default('Rig Relay static evidence site — generated from canonical structured artifacts.') }}">
{% if og_title %}<meta property="og:title" content="{{ og_title }}">{% endif %}
{% if og_description %}<meta property="og:description" content="{{ og_description }}">{% endif %}
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'">
<link rel="stylesheet" href="{{ relative_root }}/assets/site.css">
<meta name="relative-root" content="{{ relative_root }}">
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <div class="eyebrow"><a href="{{ relative_root }}/index.html">Rig Relay</a> / {{ nav_section | default('Evidence Dossier') }}</div>
  <h1>{{ title }}</h1>
  {% if safety_status %}<div class="safety-badge safety-{{ safety_status }}">{{ safety_status | replace('_', ' ') | title }}</div>{% endif %}
</header>
<div class="main-wrapper">
  <aside class="sidebar-nav">
    <h2>Dossier Overview</h2>
    <nav aria-label="Evidence dossier navigation">
      <ul class="nav-links">
        <li>
          <a class="nav-item-link{% if not page_id %} active{% endif %}" href="{{ relative_root }}/index.html">
            <strong>Dossier Index</strong>
            <span>Verification & readiness</span>
          </a>
        </li>
        {% for p in nav_pages %}
        <li>
          <a class="nav-item-link{% if page_id == p.page_id %} active{% endif %}" href="{{ p.route }}">
            <strong>{{ p.title }}</strong>
            <span>{{ p.description | default('Page evidence') }}</span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </nav>
  </aside>
  <main id="main">
    {% block content %}{% endblock %}
  </main>
</div>
<footer class="site-footer">
  <p>Generated {{ generated_at }} from {% if source_artifact_paths %}{{ source_artifact_paths | join(', ') }}{% else %}site configuration{% endif %}. <a href="{{ relative_root }}/index.html">Site index</a>.</p>
</footer>
</body>
</html>
