{% extends "base.html.j2" %}
{% block content %}
{% if front_door and front_door.hero %}
<section class="public-hero product-hero">
  <h2>{{ front_door.hero.headline }}</h2>
  <p class="thesis">{{ front_door.hero.subhead }}</p>
  <div class="cta-grid">
    {% if front_door.hero.primary_cta %}<a class="cta-link cta-primary" href="{{ front_door.hero.primary_cta.url }}">{{ front_door.hero.primary_cta.text }}</a>{% endif %}
    {% if front_door.hero.secondary_cta %}<a class="cta-link cta-secondary" href="{{ front_door.hero.secondary_cta.url }}">{{ front_door.hero.secondary_cta.text }}</a>{% endif %}
    <a class="cta-link cta-secondary" href="#evidence">Browse Evidence</a>
    {% if github_url %}<a class="cta-link cta-secondary" href="{{ github_url }}">GitHub</a>{% endif %}
  </div>
</section>

{% if front_door.problem %}
<h2 class="section-heading">{{ front_door.problem.headline | default("Coding Agents Need Governance") }}</h2>
<p>{{ front_door.problem.body }}</p>
{% endif %}

{% if front_door.pillars %}
<h2 class="section-heading">Product Pillars</h2>
<div class="feature-grid">
  {% for p in front_door.pillars %}
  <div class="feature-card pillar-{{ p.status }}">
    <h3>{{ p.title }} <span class="status-chip chip-{{ p.status }}">{{ p.status }}</span></h3>
    <p>{{ p.body }}</p>
    {% if p.source_ref %}<div class="card-source">Source: {{ p.source_ref }}</div>{% endif %}
  </div>
  {% endfor %}
</div>
{% endif %}

{% if front_door.trust_pipeline %}
<h2 class="section-heading">Trust Pipeline</h2>
<div class="pipeline">
  {% for step in front_door.trust_pipeline %}
  <div class="pipeline-step pipeline-{{ step.status }}">
    <span class="pipeline-label">{{ step.step }}</span>
    <span class="pipeline-copy">{{ step.copy }}</span>
    <span class="status-chip chip-{{ step.status }}">{{ step.status }}</span>
  </div>
  {% endfor %}
</div>
{% endif %}

{% if front_door.enterprise_posture %}
<h2 class="section-heading">{{ front_door.enterprise_posture.headline | default("Honest About Maturity") }}</h2>
<p>{{ front_door.enterprise_posture.body }}</p>
{% if front_door.enterprise_posture.cta_url %}<p><a class="cta-link cta-secondary" href="{{ front_door.enterprise_posture.cta_url }}">Read the Enterprise Procurement Readiness Audit</a></p>{% endif %}
{% endif %}

{% if front_door.evidence_site %}
<h2 class="section-heading">{{ front_door.evidence_site.headline | default("Static Evidence Site") }}</h2>
<p>{{ front_door.evidence_site.body }}</p>
{% if front_door.evidence_site.cta_url %}<p><a class="cta-link cta-secondary" href="{{ front_door.evidence_site.cta_url }}">Browse Full Evidence Index</a></p>{% endif %}
{% endif %}

{% else %}
<section class="public-hero">
  <h2>Rig Relay</h2>
  <p class="thesis">A governed local agent platform for making AI-assisted software work inspectable, auditable, and refusal-first.</p>
  <p class="explanation">AI agents can change code faster than people can inspect what happened. Rig Relay turns agent execution, provider access, protocol calls, compiler candidates, bridge events, runtime observations, CI evidence, and coordination artifacts into schema-governed, trace-correlated, content-light, refusal-first local evidence.</p>
  <div class="cta-grid">
    <a class="cta-link cta-primary" href="#evidence">View evidence</a>
    <a class="cta-link cta-secondary" href="/proof-chain/index.html">Inspect proof chain</a>
    <a class="cta-link cta-secondary" href="/release-candidate/index.html">Release readiness</a>
    <a class="cta-link cta-secondary" href="/contracts/index.html">Read contracts</a>
    {% if github_url %}<a class="cta-link cta-secondary" href="{{ github_url }}">GitHub repository</a>{% endif %}
  </div>
</section>

<h2 class="section-heading">Why It Matters</h2>
<p>Most AI coding agents operate as black boxes. They mutate code, call external APIs, and produce results with no audit trail. Rig Relay rejects that model. Every tool call is permission-gated, every action produces verifiable receipts, every protocol boundary has a refusal vocabulary, and every release candidate is validated against schema-governed contracts before promotion. The evidence is not marketing — it is inspectable.</p>

<h2 class="section-heading">What Rig Relay Does</h2>
<div class="feature-grid">
  <div class="feature-card"><h3>Governed Execution</h3><p>Agent tools are permission-gated with ToolPermission (ALWAYS/ASK/NEVER). Destructive operations require explicit approval. Stale batch reuse is prevented by lease-gated supervision.</p></div>
  <div class="feature-card"><h3>Trace-Correlated Evidence</h3><p>Every agent action carries trace IDs and correlation IDs across 10 surfaces. Content-light doctrine ensures secrets never leak into traces. Cross-surface events are joinable.</p></div>
  <div class="feature-card"><h3>Refusal-First Boundaries</h3><p>A shared refusal vocabulary with 29 classes spans MCP, ACP, A2A, SDK, and provider surfaces. Capabilities are refused by default and granted explicitly.</p></div>
  <div class="feature-card"><h3>Schema-Governed Contracts</h3><p>{{ schema_count }}+ JSON schemas govern every artifact type. Implementation contracts are encoded as JSON with authority hashes. The deterministic compiler validates worktrees against contracts.</p></div>
  <div class="feature-card"><h3>Protocol Spine</h3><p>MCP (Model Context Protocol), ACP (Agent Client Protocol), A2A (Agent-to-Agent), and SDK surfaces each have capability manifests, readiness checks, and refusal adapters.</p></div>
  <div class="feature-card"><h3>Static Evidence Site</h3><p>This site is deterministically generated from canonical JSON artifacts. No backend, no database, no tracking. Every page is schema-validated and safety-scanned before publication.</p></div>
</div>
{% endif %}

<h2 class="section-heading">What Is Proven Now</h2>
<div class="metrics-row">
  <div class="metric-box"><span class="metric-value">{{ schema_count }}</span><span class="metric-label">Schemas Validated</span></div>
  {% if proof_summary.test_count %}<div class="metric-box"><span class="metric-value">{{ proof_summary.test_count }}</span><span class="metric-label">Test Functions</span></div>{% endif %}
  {% if proof_summary.test_files %}<div class="metric-box"><span class="metric-value">{{ proof_summary.test_files }}</span><span class="metric-label">Test Files</span></div>{% endif %}
  <div class="metric-box"><span class="metric-value">{{ pages | length }}</span><span class="metric-label">Evidence Pages</span></div>
  {% if release_summary.status %}<div class="metric-box"><span class="metric-value">{{ release_summary.status | upper }}</span><span class="metric-label">Gate Verdict</span></div>{% endif %}
</div>
{% if public_claims %}
<div class="claim-boundary claims-supported">
  <h3>What We Claim</h3>
  <ul>
    {% for claim in public_claims %}<li>{{ claim }}</li>{% endfor %}
  </ul>
</div>
{% endif %}

{% if rejected_claims %}
<h2 class="section-heading">What We Do Not Claim</h2>
<div class="claim-boundary claims-rejected">
  <h3>Explicitly Rejected</h3>
  <ul>
    {% for claim in rejected_claims %}<li>{{ claim }}</li>{% endfor %}
  </ul>
</div>
{% endif %}

{% if remaining_seams %}
<h2 class="section-heading">What Is Intentionally Deferred</h2>
<div class="claim-boundary claims-deferred">
  <h3>Known Seams &amp; Deferrals</h3>
  <ul>
    {% for seam in remaining_seams %}<li>{{ seam }}</li>{% endfor %}
  </ul>
</div>
{% endif %}

<h2 class="section-heading" id="evidence">Evidence You Can Inspect</h2>
<div class="card-grid">
  {% for p in pages %}
  <div class="card{% if p.status == 'rendered' %} status-ok{% endif %}">
    <h3><a href="{{ p.route }}">{{ p.title }}</a></h3>
    <div class="card-body">
      <p>{{ p.description | default('Compiled evidence and validation logs.') }}</p>
    </div>
    <div class="card-source">Route: {{ p.route }}</div>
  </div>
  {% endfor %}
</div>

<div class="provenance-footer">
  <p>Generated <code>{{ generated_at }}</code> · Branch <code>{{ branch }}</code> · SHA <code>{{ head_sha }}</code> · {{ pages | length }} evidence pages · Safety {{ 'passed' if safety_passed else 'hold' }}</p>
  {% if front_door and front_door.footer %}
  <p class="footer-meta">{{ front_door.footer.license }} · <a href="{{ front_door.footer.github }}">GitHub</a> · Content-light · No tracking</p>
  {% endif %}
</div>
{% endblock %}
