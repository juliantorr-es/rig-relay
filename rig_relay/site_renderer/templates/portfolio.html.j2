{% extends "base.html.j2" %}
{% block content %}
{% set m = model | default({}) %}
<style>
.hero-public { text-align:center; padding:clamp(1.5rem,4vw,3rem) clamp(1rem,3vw,2rem); }
.hero-content .tagline { font-size:clamp(1rem,2.5vw,1.25rem); max-width:42rem; margin:0 auto 1.5rem; color:var(--text-secondary,#4a5568); }
.hero-actions { display:flex; flex-wrap:wrap; gap:1rem; justify-content:center; }
.action-card { display:block; padding:1rem 1.25rem; border:1px solid var(--border,#e2e8f0); border-radius:.5rem; text-decoration:none; color:inherit; max-width:18rem; text-align:left; }
.action-card strong { display:block; margin-bottom:.25rem; }
.action-card span { font-size:.875rem; color:var(--text-secondary,#718096); }
.card-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(18rem,100%),1fr)); gap:clamp(.75rem,2vw,1.5rem); }
.card { border:1px solid var(--border,#e2e8f0); border-radius:.5rem; padding:1rem; }
.card h3 { margin:0 0 .5rem; }
.card-body { font-size:.875rem; color:var(--text-secondary,#4a5568); }
.status-info { border-left:3px solid var(--info,#3182ce); }
.table-wrapper { overflow-x:auto; -webkit-overflow-scrolling:touch; }
.table-wrapper table { width:100%; border-collapse:collapse; font-size:.875rem; }
.table-wrapper th,.table-wrapper td { text-align:left; padding:.5rem .75rem; border-bottom:1px solid var(--border,#e2e8f0); }
.table-wrapper th { font-weight:600; }
@media (max-width:640px) {
  .table-wrapper table,.table-wrapper thead,.table-wrapper tbody,.table-wrapper th,.table-wrapper td,.table-wrapper tr { display:block; }
  .table-wrapper thead tr { display:none; }
  .table-wrapper td { padding:.5rem; border-bottom:1px solid var(--border,#e2e8f0); }
  .table-wrapper td::before { content:attr(data-label); font-weight:600; display:block; margin-bottom:.25rem; }
}
.metrics { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; font-size:.875rem; padding:1rem 0; }
.metrics span { white-space:nowrap; }
.callout { padding:1rem 1.25rem; border-radius:.5rem; margin:1rem 0; }
.callout-info { background:var(--info-bg,#ebf8ff); border-left:3px solid var(--info,#3182ce); }
section { padding:clamp(.75rem,2vw,2rem) clamp(.5rem,2vw,1.5rem); max-width:64rem; margin:0 auto; }
section h2 { margin:0 0 1rem; font-size:clamp(1.125rem,3vw,1.5rem); }
</style>

{% if m.hero_name %}
<section class="hero-public">
  <div class="hero-content">
    <p class="tagline">{{ m.tagline | default('') }}</p>
    {% if m.action_links %}
    <div class="hero-actions">
      {% for link in m.action_links %}
      <a href="{{ link.url }}" class="action-card"><strong>{{ link.label }}</strong><span>{{ link.description }}</span></a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

{% if m.tech_stack %}
<section>
  <h2>Tech Stack</h2>
  <div class="card-grid">
    {% for item in m.tech_stack %}
    <div class="card"><h3>{{ item.name }}</h3><div class="card-body">{{ item.description }}</div></div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if m.projects %}
<section>
  <h2>Projects</h2>
  <div class="card-grid">
    {% for proj in m.projects %}
    <div class="card status-info">
      <h3>{% if proj.url %}<a href="{{ proj.url }}">{{ proj.name }}</a>{% else %}{{ proj.name }}{% endif %}</h3>
      <div class="card-body">{{ proj.description }}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if m.governance_rows %}
<section>
  <h2>Security &amp; Governance</h2>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>Scope</th><th>Default</th></tr></thead>
      <tbody>
        {% for row in m.governance_rows %}
        <tr><td data-label="Scope">{{ row.scope }}</td><td data-label="Default">{{ row.default }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{% if m.content_light_heading %}
<section class="callout callout-info">
  <h3>{{ m.content_light_heading }}</h3>
  <p>{{ m.content_light_body | default('') }}</p>
</section>
{% endif %}

{% if m.stats %}
<section>
  <h2>Stats</h2>
  <div class="metrics">
    {% for s in m.stats %}<span>{{ s }}</span>{% endfor %}
  </div>
</section>
{% endif %}

{% if m.links %}
<section>
  <h2>Links</h2>
  <div class="card-grid">
    {% for link in m.links %}
    <div class="card"><h3><a href="{{ link.url }}">{{ link.label }}</a></h3><div class="card-body">{{ link.description }}</div></div>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
