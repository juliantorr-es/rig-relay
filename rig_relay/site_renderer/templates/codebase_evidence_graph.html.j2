{% extends "base.html.j2" %}
{% block content %}
{% set m = model | default({}) %}
<style>
.hero-status { padding:clamp(1rem,3vw,2rem); text-align:center; }
.status-badge { display:inline-block; padding:.25rem .75rem; border-radius:999px; font-size:.875rem; }
.status-info { background:var(--info-bg,#ebf8ff); color:var(--info-text,#2b6cb0); }
.summary { max-width:48rem; margin:.75rem auto; font-size:.875rem; color:var(--text-secondary,#4a5568); }
.metrics { display:flex; flex-wrap:wrap; gap:.5rem 1.5rem; justify-content:center; font-size:.875rem; padding:.5rem 0; }
.metrics span { white-space:nowrap; }
.table-wrapper { overflow-x:auto; -webkit-overflow-scrolling:touch; margin:1rem 0; }
.table-wrapper table { width:100%; border-collapse:collapse; font-size:.875rem; }
.table-wrapper th,.table-wrapper td { text-align:left; padding:.5rem .75rem; border-bottom:1px solid var(--border,#e2e8f0); }
.table-wrapper th { font-weight:600; }
@media (max-width:640px) {
  .table-wrapper table,.table-wrapper thead,.table-wrapper tbody,.table-wrapper th,.table-wrapper td,.table-wrapper tr { display:block; }
  .table-wrapper thead tr { display:none; }
  .table-wrapper td { padding:.5rem; border-bottom:1px solid var(--border,#e2e8f0); }
  .table-wrapper td::before { content:attr(data-label); font-weight:600; display:block; margin-bottom:.25rem; }
}
.card-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(min(16rem,100%),1fr)); gap:clamp(.5rem,2vw,1rem); }
.card { border:1px solid var(--border,#e2e8f0); border-radius:.5rem; padding:1rem; }
.card h3 { margin:0 0 .5rem; font-size:1rem; }
.card-body { font-size:.875rem; color:var(--text-secondary,#4a5568); }
.status-info { border-left:3px solid var(--info,#3182ce); }
.callout { padding:1rem 1.25rem; border-radius:.5rem; margin:1rem 0; }
.callout-info { background:var(--info-bg,#ebf8ff); border-left:3px solid var(--info,#3182ce); }
pre { background:var(--code-bg,#edf2f7); padding:1rem; border-radius:.375rem; overflow-x:auto; font-size:.8125rem; }
section { padding:clamp(.75rem,2vw,2rem) clamp(.5rem,2vw,1.5rem); max-width:64rem; margin:0 auto; }
section h2 { margin:0 0 1rem; font-size:clamp(1.125rem,3vw,1.5rem); }
</style>

<section class="hero-status">
  <h2>{{ m.total_nodes | default("...") }} nodes &middot; {{ m.total_edges | default("...") }} edges</h2>
  <div class="status-badge status-info">{{ m.total_nodes | default("...") }} nodes &middot; {{ m.total_edges | default("...") }} edges</div>
  <p class="summary">{{ meta_description | default(description) }}</p>
  <div class="metrics">
    <span>{{ m.node_types | default(0) }} node types</span><span>{{ m.edge_types | default(0) }} edge types</span><span>{{ m.total_nodes | default("...") }} nodes</span><span>{{ m.total_edges | default("...") }} edges</span>
  </div>
</section>

{% if m.node_distribution %}
<section>
  <h2>Node Type Distribution</h2>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>Node Type</th><th>Count</th></tr></thead>
      <tbody>
        {% for row in m.node_distribution %}
        <tr><td data-label="Node Type">{{ row.type }}</td><td data-label="Count">{{ row.count }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

{% if m.edge_distribution %}
<section>
  <h2>Edge Types</h2>
  <div class="table-wrapper">
    <table>
      <thead><tr><th>Edge Type</th><th>Count</th><th>Description</th></tr></thead>
      <tbody>
        {% for row in m.edge_distribution %}
        <tr><td data-label="Edge Type">{{ row.type }}</td><td data-label="Count">{{ row.count }}</td><td data-label="Description">{{ row.description }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endif %}

<section class="callout callout-info">
  <h3>Content-Light Guarantee</h3>
  <p>All code content is stored as hashes only. Relative paths only — never absolute home paths. No raw source in canonical JSON. No tokens, secrets, or private files. Generated deterministically from committed artifacts.</p>
</section>

{% if m.projection_modes %}
<section>
  <h2>Projection Modes</h2>
  <div class="card-grid">
    {% for mode in m.projection_modes %}
    <div class="card status-info">
      <h3>{{ mode.name }}</h3>
      <div class="card-body">{{ mode.description }}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if m.regeneration_commands %}
<section>
  <h2>Regeneration</h2>
  <p>The graph auto-refreshes on milestone-tagged pushes via the pre-push hook. Manual refresh via:</p>
  <pre><code>{{ m.regeneration_commands | join('\n') }}</code></pre>
</section>
{% endif %}
{% endblock %}
