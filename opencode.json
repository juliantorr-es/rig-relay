{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "PROJECT.md",
    "AGENTS.md",
    "docs/governance/mission-envelope.md",
    "docs/governance/cross-session-coordination.md",
    "docs/governance/step-up-authorization.md",
    "docs/governance/identity-provider-policy.md",
    "docs/governance/usage-data-doctrine.md",
    "docs/governance/reviewer-orchestrator.md",
    "docs/governance/prepublication-falsifier-contract.md",
    "docs/governance/delegate-fleet-orchestration.md",
    "README.md",
    "pyproject.toml"
  ],
  "default_agent": "orchestrator",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "edit": "allow",
    "bash": "allow",
    "boundary_claim_verify": "deny",
    "publish_admitted_candidate": "deny",
    "remote_boundary_inspect": "deny",
    "task": {
      "*": "deny",
      "plan": "allow",
      "explore": "allow",
      "scout": "allow",
      "plan-critic": "allow",
      "execution": "allow",
      "validator": "allow",
      "prepublication-conductor": "allow",
      "publisher": "allow",
      "remote-main-reviewer": "allow",
      "cleaner": "allow",
      "repairer": "allow",
      "claim-scope-adversary": "allow",
      "evidence-adversary": "allow",
      "production-proof-adversary": "allow",
      "authority-adversary": "allow",
      "recovery-adversary": "allow",
      "claim-adversary": "allow",
      "publication-truth-adversary": "allow",
      "lane-collision-adversary": "allow",
      "security-adversary": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": "allow",
    "skill": {
      "*": "deny",
      "graphify": "allow"
    },
    "doom_loop": "deny"
  },
  "lsp": true,
  "formatter": {
    "ruff": {
      "command": [
        "uv",
        "run",
        "ruff",
        "format",
        "$FILE"
      ],
      "extensions": [
        ".py",
        ".pyi"
      ]
    }
  },
  "watcher": {
    "ignore": [
      "**"
    ]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "snapshot": false
}
