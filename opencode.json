{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "docs/governance/mission-envelope.md",
    "docs/governance/cross-session-coordination.md",
    "docs/governance/usage-data-doctrine.md",
    "docs/governance/reviewer-orchestrator.md",
    "docs/governance/delegate-fleet-orchestration.md",
    "README.md",
    "pyproject.toml"
  ],
  "permission": "allow",
  "lsp": true,
  "formatter": {
    "ruff": {
      "command": ["uv", "run", "ruff", "format", "$FILE"],
      "extensions": [".py", ".pyi"]
    }
  },
  "watcher": {
    "ignore": [".build/**", "dist/**", "sdist/**", ".venv/**", "node_modules/**", ".git/**"]
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
